+static int rt942x_enter_calibration_mode(struct rt942x_chip *chip)
+{
+	int i, regval, retry_times, ret = RT942X_CALI_MODE_FAIL;
+	int j, tick_old = 0, tick_new = 0;
+
+	retry_times = 3;
+	for (i = 0; i < retry_times; i++) {
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2);
+
+		if ((regval & RT942X_CALI_MODE_MASK) == RT942X_CALI_MODE_MASK) {
+			dev_info(chip->dev, "RT942x is in Calibration Mode\n");
+			ret = RT942X_CALI_MODE_PASS;
+			break;
+		}
+		if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_PASS) {
+			/* Check System Tick before entering Calibration */
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_SYS_TICK_ON_CMD);
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+			mdelay(5);
+			tick_old = rt942x_reg_read_word(chip->i2c, RT942X_REG_ADV);
+			for (j = 0; j < 1000; j++) {
+				tick_new = rt942x_reg_read_word(chip->i2c, RT942X_REG_ADV);
+				if (tick_old != tick_new) {
+					mdelay(300);
+					break;
+				}
+				mdelay(5);
+			}
+			/* Send Cmd to Enter Calibration */
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_CALI_ENTR_CMD);
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+			/* Disable System Tick */
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_SYS_TICK_OFF_CMD);
+			if (i >= 2) {
+				dev_info(chip->dev,
+					 "RT942x Enter Calibration Mode Fail after 3 retries\n");
+				goto out;
+			}
+			mdelay(5);
+		}
+out:
+		rt942x_unseal_wi_retry(chip, false);
+	}
+
+	return ret;
+}
+
+static void rt942x_exit_calibration_mode(struct rt942x_chip *chip)
+{
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_CALI_EXIT_CMD);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+}
+
+static void rt942x_apply_sense_resistor(struct rt942x_chip *chip)
+{
+	int p10_w3_setting = 0, p1_w1_setting = 0;
+
+	/* get p1_w1_setting setting from extreg table ; 2022-06-09 */
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_PASS) {
+		if (chip->pdata->extreg_table[10][4] == 0) {
+			/* get p1_w1_setting */
+			p1_w1_setting = chip->pdata->extreg_table[1][0] |
+					chip->pdata->extreg_table[1][1] << 8;
+			/* apply p1_w1_setting */
+			rt942x_write_page_cmd(chip, RT942X_PAGE_1);
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW1, p1_w1_setting);
+			dev_info(chip->dev, "%s, apply p1_w1_setting = 0x%04X",
+					__func__, p1_w1_setting);
+		} else {
+			/* get p10_w3_setting */
+			p10_w3_setting = chip->pdata->extreg_table[10][4] |
+					 chip->pdata->extreg_table[10][5] << 8;
+			/* apply p10_w3_setting */
+			rt942x_write_page_cmd(chip, RT942X_PAGE_10);
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW3, p10_w3_setting);
+			dev_info(chip->dev, "%s, apply p10_w3_setting = 0x%04X",
+					__func__, p10_w3_setting);
+		}
+	}
+	mdelay(5);
+
+	rt942x_unseal_wi_retry(chip, false);
+}
+
+static void rt942x_apply_calibration_para(struct rt942x_chip *chip, u8 curr_offs, u16 curr_gain, u8 volt_gain)
+{
+	int regval = 0;
+
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_PASS) {
+		rt942x_write_page_cmd(chip, RT942X_PAGE_0);
+		/* set Current system gain & offset */
+		if ((curr_gain != 0x00) && (curr_gain != 0xFF) && (curr_gain != 0xFFFF) &&
+				(curr_offs != 0x00) && (curr_offs != 0xFF)) {
+			if (chip->ic_ver == RT9426A_DEVICE_ID)
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW1,
+						(0xFF & curr_gain) | (curr_offs << 8));
+			else {
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW1,
+						curr_gain);
+				regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW2);
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW2,  /* 07/28: fix bug */
+						(0xFF00 & regval) | curr_offs);
+			}
+		} else {
+			if (chip->ic_ver == RT9426A_DEVICE_ID)
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW1, 0x8080);
+			else {
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW1, 0x8000);
+				regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW2);
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW2,
+						(0xFF00 & regval) | 0x80);
+			}
+		}
+		/* set Voltage system gain */
+		if ((volt_gain != 0x00) && (volt_gain != 0xFF)) {
+			if (chip->ic_ver == RT9426A_DEVICE_ID)
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW7,
+						0x88 | (volt_gain << 8));
+			else {
+				regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW2);
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW2,
+						(0xFF & regval) | (volt_gain << 8));
+			}
+		} else {
+			if (chip->ic_ver == RT9426A_DEVICE_ID)
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW7, 0x8088);
+			else {
+				regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW2);
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW2,
+						(0xFF & regval) | (0x80 << 8));
+			}
+		}
+		mdelay(5);
+	}
+
+	rt942x_unseal_wi_retry(chip, false);
+}
+
+static int rt942x_get_curr_by_conversion(struct rt942x_chip *chip)
+{
+	int regval = 0;
+
+	if (rt942x_enter_calibration_mode(chip) == RT942X_CALI_MODE_PASS) {
+		/* Start current conversion */
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_CURR_CONVERT_CMD);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(50);
+
+		/* Get convert result */
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_CURR);
+		if (regval < 0)
+			return -EIO;
+		if (regval > 0x7FFF) {
+			regval = 0x10000 - regval;
+			regval = 0 - regval;
+		}
+	}
+
+	/* scaling for the current ; RT9426A only */
+	if (chip->ic_ver == RT9426A_DEVICE_ID)
+		regval = regval * chip->pdata->rs_ic_setting /
+				  chip->pdata->rs_schematic;
+
+	dev_info(chip->dev, "CALIB_CURRENT = %d mA\n", regval);
+
+	return regval;
+}
+
+static int rt942x_get_volt_by_conversion(struct rt942x_chip *chip)
+{
+	int regval = 0;
+
+	if (rt942x_enter_calibration_mode(chip) == RT942X_CALI_MODE_PASS) {
+		/* Start voltage conversion */
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_VOLT_CONVERT_CMD);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(50);
+
+		/* Get voltage result */
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_VBAT);
+	}
+	return regval;
+}
+
+/* for Enter/Exit Hibernate or Shutdown */
+/* for RT9426A: Shutdown Mode           */
+/* for RT9427: Hibernate Mode           */
+static int rt942x_enter_hibernate_mode(struct rt942x_chip *chip)
+{
+	int regval, loop;
+
+	for (loop = 0; loop < 5; loop++) {
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2);
+		if (regval & RT942X_HIB_MASK)
+			break;
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_HIB_ENTR_CMD);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(20);
+	}
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2);
+	if (!(regval & RT942X_HIB_MASK)) {
+		if (chip->ic_ver == RT9426A_DEVICE_ID)
+			dev_info(chip->dev, "RT9426A Enter Shutdown Fail\n");
+		else
+			dev_info(chip->dev, "RT9427 Enter Hibernate Fail\n");
+		return -1;
+	}
+	if (chip->ic_ver == RT9426A_DEVICE_ID)
+		dev_info(chip->dev, "RT9426A Enter Shutdown Success\n");
+	else
+		dev_info(chip->dev, "RT9427 Enter Hibernate Success\n");
+	return 0;
+}
+
+static int rt942x_fg_set_soc(struct rt942x_chip *chip, int soc_target)
+{
+	int i, regval, retry_times = 3, ret = RT942X_WRITE_SOC_FAIL;
+
+	for (i = 0; i < retry_times; i++) {
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SOC);
+		if (regval == soc_target) {
+			ret = soc_target;
+			dev_info(chip->dev, "%s: Set SOC PASS.\n", __func__);
+			break;
+		}
+		regval = RT942X_SET_SOC_KEY | ((soc_target * 2) & 0xFF);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, regval);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(5);
+		if (i > 0)
+			dev_err(chip->dev, "%s: Set SOC FAIL Cnt = %d.\n", __func__, i);
+	}
+
+	return ret;
+}
+
+static void rt942x_init_soc(struct rt942x_chip *chip)
+{
+	int i = 0, reg_flag2 = 0, reg_flag3 = 0;
+	int volt_now = 0, curr_now = 0, volt_comp = 0;
+	const int retry_times = 30;
+
+	/* get init. soc by ir_comp & loopup table or qs cmd ; 2022-05-16 */
+	if (chip->pdata->ir_comp_resistance <= 0)
+		goto QS_CMD;
+
+	for (i = 0; i < retry_times; i++) {
+		reg_flag2 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2);
+		if ((reg_flag2 != 0xFFFF) && (reg_flag2 & RT942X_RDY_MASK))
+			break;
+		mdelay(10);
+	}
+	if (i >= retry_times)
+		goto QS_CMD;
+
+	curr_now = rt942x_get_current(chip);
+	if (abs(curr_now) <= chip->pdata->ir_comp_threshold)
+		goto QS_CMD;
+
+	volt_now = rt942x_reg_read_word(chip->i2c, RT942X_REG_VBAT);
+	volt_comp = volt_now -
+		((curr_now * (int)chip->pdata->ir_comp_resistance) / 1000);
+	dev_info(chip->dev, "curr_now = %d, volt_now = %d, volt_comp = %d\n",
+			curr_now, volt_now, volt_comp);
+	for (i = 0; i < 100; i++) {
+		if (volt_comp <= chip->pdata->init_ocv_table[i])
+			break;
+	}
+	dev_info(chip->dev, "init. soc = %d\n", i);
+	rt942x_fg_set_soc(chip, i);
+	dev_info(chip->dev, "Get init. soc by ir_comp. & lookup table\n");
+	return;
+QS_CMD:
+	reg_flag3 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+	if ((reg_flag3 != 0xFFFF) && (reg_flag3 & RT942X_RI_MASK))
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, chip->pdata->qs_source);
+	else
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_QS_CMD);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+	mdelay(5);
+	dev_info(chip->dev, "Get init. soc by qs command.\n");
+}
+
+static int rt942x_exit_hibernate_mode(struct rt942x_chip *chip)
+{
+	int regval = 0, retried = 0;
+	const int retry_cnt = 5;
+
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2);
+	if (!(regval & RT942X_HIB_MASK))
+		return 0;
+
+	do {
+		if (chip->ic_ver == RT9426A_DEVICE_ID)
+			dev_info(chip->dev, "RT9426A Send Exit Shutdown Cmd\n");
+		else
+			dev_info(chip->dev, "RT9427 Send Exit Hibernate Cmd\n");
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_HIB_EXIT_CMD);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(250);
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2);
+		if (!(regval & RT942X_HIB_MASK))
+			break;
+	} while (++retried <= retry_cnt);
+
+	if (retried <= retry_cnt) {
+		if (chip->ic_ver == RT9426A_DEVICE_ID)
+			dev_info(chip->dev, "RT9426A is not in Shutdown\n");
+		else
+			dev_info(chip->dev, "RT9427 is not in Hibernate\n");
+		rt942x_init_soc(chip);
+		return 0;
+	}
+
+	if (chip->ic_ver == RT9426A_DEVICE_ID)
+		dev_info(chip->dev, "RT9426A is in Shutdown\n");
+	else
+		dev_info(chip->dev, "RT9427 is in Hibernate\n");
+
+	return -1;
+}
+
+/* new for rt9427 BAPA function ; 2022-05-14 */
+static int rt9427_battery_aging_profile_adjust(struct rt942x_chip *chip, u8 fc_offset, u8 edv_offset)
+{
+	u8 i;
+	u16 regval;
+
+	/*----Set FC voltage offset----*/
+	if (rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, (RT9427_BAPA_FC_CMD | fc_offset)) >= 0) {
+		mdelay(5);
+		/*----Polling Busy flag----*/
+		for (i = 0; i < 50; i++) {
+			regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+			mdelay(1);
+			if ((regval & RT942X_GAUGE_BUSY_MASK) == 0x0000)
+				break;
+		}
+	} else {
+		dev_info(chip->dev, "Set BAPA, FC voltage offset CMD Fail\n");
+		return -1;
+	}
+
+	/*----Set EDV voltage offset----*/
+	if (rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, (RT9427_BAPA_EDV_CMD | edv_offset)) >= 0) {
+		mdelay(5);
+		/*----Polling Busy flag----*/
+		for (i = 0; i < 50; i++) {
+			regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+			mdelay(1);
+			if ((regval & RT942X_GAUGE_BUSY_MASK) == 0x0000)
+				break;
+		}
+	} else {
+		dev_info(chip->dev, "Set BAPA, EDV voltage offset CMD Fail\n");
+		return -1;
+	}
+
+	dev_info(chip->dev, "Set Battery_Aging_Profile_Adjust Pass\n");
+	return 0;
+}
+
+static int rt9427_bapa_fcc_gain_offset(struct rt942x_chip *chip, int bapa_gain_offset)
+{
+	u8 value;
+
+	/*----Limit Max/Min offset is 50%----*/
+	if (bapa_gain_offset > 50)
+		value = 50;
+	else if (bapa_gain_offset < -50)
+		value = 0xCE;   /* 0xCE = -50% */
+	else
+		value = bapa_gain_offset;
+
+	/*----Set BAPA FCC Gain offset----*/
+	if (rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, (RT9427_BAPA_FCC_GAIN_CMD | value)) >= 0) {
+		dev_info(chip->dev, "%s Pass\n", __func__);
+		return 0;
+	}
+	dev_info(chip->dev, "%s Fail\n", __func__);
+	return -1;
+}
+
+static int rt9427_ieoc_offset(struct rt942x_chip *chip, int ieoc_offset)
+{
+	u8 value;
+
+	if (ieoc_offset < 0) {
+		value = 0 - ieoc_offset;
+		value = 0x100 - value;
+	}
+	value = ieoc_offset;
+	/*----Set IEOC offset----*/
+	if (rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, (RT9427_IEOC_OFF_CMD | value)) == 0) {
+		dev_info(chip->dev, "%s CMD Pass\n", __func__);
+		return 0;
+	}
+	dev_info(chip->dev, "%s CMD Fail\n", __func__);
+	return -1;
+}
+
+static int rt9427_bapa_index_table_update(struct rt942x_chip *chip)
+{
+	u8 i = 0, j = 0, retry_times = 3, fail_cnt = 0;
+	u16 regval = 0;
+	u16 page_checksum[3] = {0};
+
+	if (chip->ic_ver == RT9426A_DEVICE_ID)
+		return RT9427_PASS;
+
+	while (retry_times) {
+		/*----Updated BAPA index table and get page checksum----*/
+		for (i = 0; i < 3; i++) {
+			rt9427_extended_control_access(chip, RT9427_BAPA_IDX_CMD + i);
+			for (j = 0; j < 8; j++) {
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW1 + j * 2,
+						      chip->pdata->bapa_index_table[i * 8 + j]);
+				page_checksum[i] = page_checksum[i] + chip->pdata->bapa_index_table[i * 8 + j];
+			}
+			mdelay(1);
+		}
+
+		/*----Check page checksum----*/
+		fail_cnt = 0;
+		for (i = 0; i < 3; i++) {
+			rt9427_extended_control_access(chip, RT9427_BAPA_IDX_CMD + i);
+
+			regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW9);
+
+			if (regval != (0xFFFF - page_checksum[i])) {
+				fail_cnt++;
+				dev_info(chip->dev, "BAPA Index Checksum fail\n");
+			}
+		}
+
+		if (fail_cnt == 0)
+			break;
+	}
+
+	if (fail_cnt == 0) {
+		dev_info(chip->dev, "RT9427 BAPA Index Table Pass\n");
+		return RT9427_PASS;
+	}
+	dev_info(chip->dev, "RT9427 BAPA Index Table FAIL\n");
+	return RT9427_FAIL;
+}
