+static int rt942x_irq_enable(struct rt942x_chip *chip, bool enable)
+{
+	int regval;
+	int opcfg2 = 0;
+
+	opcfg2 = chip->pdata->extreg_table[1][2] |
+		 chip->pdata->extreg_table[1][3] << 8;
+	dev_info(chip->dev, "OPCFG2 = 0x%04x\n", opcfg2);
+
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_PASS) {
+		rt942x_write_page_cmd(chip, RT942X_PAGE_1);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW2,
+				       enable ? opcfg2 : 0);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(5);
+		/* if disable, force clear irq status */
+		if (!enable) {
+			regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_IRQ);
+			dev_info(chip->dev, "previous irq status 0x%04x\n", regval);
+		}
+	}
+
+	rt942x_unseal_wi_retry(chip, false);
+
+	return 0;
+}
+
+static int rt942x_irq_init(struct rt942x_chip *chip)
+{
+	int rc = 0;
+
+	dev_info(chip->dev, "%s\n", __func__);
+	chip->alert_irq = chip->i2c->irq;
+	rc = devm_request_threaded_irq(chip->dev, chip->alert_irq, NULL,
+				       rt942x_irq_handler,
+				       IRQF_TRIGGER_LOW | IRQF_ONESHOT,
+				       "rt942x_fg_irq", chip);
+	if (rc < 0) {
+		dev_notice(chip->dev, "irq register failed\n");
+		return rc;
+	}
+	enable_irq_wake(chip->alert_irq);
+
+	return 0;
+}
+
+static int rt942x_write_ext_reg_table(struct rt942x_chip *chip)
+{
+	int i = 0;
+	int total_cksum_retry = 0, single_cksum_retry = 0;
+	u16 total_checksum_dtsi_target = 0, total_checksum_ic_now = 0, page_checksum = 0;
+	u8 array_idx = 0;
+
+	/* unseal before writing ext reg table ; 2022-05-08 */
+	rt942x_unseal_wi_retry(chip, true);
+
+TOTAL_CHECKSUM_CHECK:
+
+	/* Calculate Checksum & CRC */
+	total_checksum_dtsi_target = rt942x_calculate_checksum_crc_from_dtsi(chip);
+
+	/* Get Total Checksum from RT9426A */
+	total_checksum_ic_now = rt942x_get_checksum_from_ic(chip);
+
+	/* Compare Total Checksum with Target */
+	dev_info(chip->dev, "Total Checksum: Target = 0x%x, IC Now = 0x%x\n",
+		 total_checksum_dtsi_target, total_checksum_ic_now);
+
+	if (total_checksum_ic_now == total_checksum_dtsi_target) {
+		return RT942X_INIT_BYPASS;
+	} else if (total_cksum_retry > 5) {
+		dev_info(chip->dev, "Write RT942x Extend Register Failed!\n");
+		return RT942X_INIT_CKSUM_ERR;
+	}
+	total_cksum_retry++;
+
+	/* Set Ext Register */
+	for (array_idx = 0; array_idx < RT942X_EXT_REG_TABLE_LOOP; array_idx++) {
+		if (chip->ic_ver == RT9426A_DEVICE_ID &&
+		    (array_idx == 4 || array_idx == 9))
+			continue;
+		single_cksum_retry = 0;
+PAGE_CHECKSUM:
+		rt942x_write_page_cmd(chip, array_idx);
+		/* Get Single Page Checksum */
+		page_checksum = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW9);
+
+		/* Rewrite a page when:                                 */
+		/* (1) single page checksum mismatch                    */
+		/* (2) single page checksum matched,                    */
+		/*     but total checksum(CRC) mismatched over 3 times. */
+		if ((page_checksum != chip->page_checksum[array_idx]) ||
+		    (total_cksum_retry > 3 && single_cksum_retry == 0)) {
+			/* Update Setting to Extend Page */
+			for (i = 0; i < 8; i++)
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW1 + 2 * i,
+						      chip->pdata->extreg_table[array_idx][2*i] |
+						      chip->pdata->extreg_table[array_idx][2*i+1] << 8);
+
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+
+			single_cksum_retry++;
+			if (single_cksum_retry < 5) {
+				dev_info(chip->dev, "Write Page-%d(%d retry)\n",
+						array_idx, single_cksum_retry);
+				goto PAGE_CHECKSUM;
+			}
+		}
+	} /*end of all page check */
+	goto TOTAL_CHECKSUM_CHECK;
+}
+
+static int rt942x_apply_pdata(struct rt942x_chip *chip)
+{
+	int regval = 0, i, retry_times, ret = RT942X_INIT_PASS;
+	int reg_flag2 = 0, reg_flag3 = 0;
+	u16 total_checksum_dtsi_target = 0;
+	int wt_ocv_result = RT942X_WRITE_OCV_FAIL;
+
+	dev_info(chip->dev, "%s\n", __func__);
+
+	/* for RT9426A, update extreg_table for BAPA parameter is necessary ; 2022-05-08 */
+	if (chip->ic_ver == RT9426A_DEVICE_ID) {
+		/* read ocv_index before using it */
+		chip->ocv_index = rt942x_reg_read_word(chip->i2c, RT942X_REG_RSVD2);
+		dev_info(chip->dev, "%s: ocv_index = %d\n", __func__, chip->ocv_index);
+		if (chip->ocv_index < 0 || chip->ocv_index >= chip->pdata->ocv_index_array_num) {
+			chip->ocv_index = 0;	/* recover ocv_index to 0 if out of range */
+			dev_info(chip->dev, "ocv_index out of range. reset to 0\n");
+		}
+		/* update ocv_checksum_dtsi after ocv_index updated */
+		chip->ocv_checksum_dtsi = chip->pdata->ocv_table[chip->ocv_index][RT942X_IDX_OF_OCV_CKSUM];
+		/* add for aging cv ; update fcc before writing */
+		chip->pdata->extreg_table[2][12] = chip->pdata->fcc[chip->ocv_index] & 0xff;
+		chip->pdata->extreg_table[2][13] = (chip->pdata->fcc[chip->ocv_index] >> 8) & 0xff;
+		/* add for aging cv ; update fc_vth before writing */
+		chip->pdata->extreg_table[5][4] = chip->pdata->fc_vth[chip->ocv_index];
+	}
+
+	/* backup opcfg1 */
+	chip->op_config_1_backup = chip->pdata->extreg_table[1][0] |
+				   chip->pdata->extreg_table[1][1] << 8;
+
+	retry_times = 30;
+	for (i = 0 ; i < retry_times ; i++) {
+		/* Check [RDY]@Reg-Flag2 & [RI]@Reg-Flag3 */
+		reg_flag2 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2);
+		reg_flag3 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+		if (((reg_flag2 & RT942X_RDY_MASK) && (reg_flag2 != 0xFFFF)) ||
+		    ((reg_flag3 & RT942X_RI_MASK) && (reg_flag3 != 0xFFFF))) {
+			/* Exit Shutdown Mode before any action */
+			rt942x_exit_hibernate_mode(chip);
+			/* Check [RI]@Reg-Flag3 & fg total checksum */
+			regval = rt942x_get_checksum_from_ic(chip);
+			total_checksum_dtsi_target = rt942x_calculate_checksum_crc_from_dtsi(chip);
+			/* get ocv checksum from fg ic before applying ocv table */
+			rt942x_get_ocv_checksum_from_ic(chip);
+			if (reg_flag3 & RT942X_RI_MASK) {
+				dev_info(chip->dev, "Init RT942x by [RI]\n");
+				break;
+			} else if (regval != total_checksum_dtsi_target) {
+				dev_info(chip->dev, "Force Init RT942x by total checksum\n");
+				dev_info(chip->dev, "IC: 0x%04X ; DTSI: 0x%04X\n", regval, total_checksum_dtsi_target);
+				break;
+			} else if (chip->ocv_checksum_ic != chip->ocv_checksum_dtsi) {
+				dev_info(chip->dev, "Force Init RT942x by OCV checksum\n");
+				dev_info(chip->dev, "IC: 0x%04X ; DTSI: 0x%04X\n", chip->ocv_checksum_ic,
+										   chip->ocv_checksum_dtsi);
+				break;
+			}
+			dev_info(chip->dev, "No need to Init RT942x\n");
+			ret = RT942X_INIT_BYPASS;
+			break;
+		} else if (i == retry_times-1) {
+			dev_info(chip->dev, "RT942x Check [RDY] fail.\n");
+		}
+		mdelay(5);
+	}
+	/* Bypass to apply RT9426A parameter */
+	if (ret < RT942X_INIT_PASS)
+		goto BYPASS_EXT_REG;
+
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_FAIL) {
+		ret = RT942X_INIT_UNSEAL_ERR;
+		goto SET_SEAL_CMD;
+	}
+
+	/*NOTICE!! Please follow below setting sequence & order                */
+	/* write ocv table in following conditions:                            */
+	/* (1)RT9426A: ocv_checksum mismatched between ic & dtsi               */
+	/* (2)RT9427: flag2[5]==0 && ocv_checksum mismatched between ic & dtsi */
+	if (chip->ocv_checksum_ic != chip->ocv_checksum_dtsi) {
+		if ((chip->ic_ver == RT9426A_DEVICE_ID) ||
+		    !(reg_flag2 & RT9427_OCV_FINE_TUNE_MASK))
+			wt_ocv_result = rt942x_write_ocv_table(chip);
+	}
+
+	/* Read Reg IRQ to reinital Alert pin state */
+	rt942x_reg_read_word(chip->i2c, RT942X_REG_IRQ);
+
+	/* ExtReg Table Initialization ; 2022-06-09 */
+	if (rt942x_write_ext_reg_table(chip) == RT942X_INIT_CKSUM_ERR)
+		goto SET_SEAL_CMD;
+
+	/* initialie bapa index table according to dtsi ; 2022-05-15 */
+	rt9427_bapa_index_table_update(chip);
+
+BYPASS_EXT_REG:
+	if (chip->ocv_checksum_ic == chip->ocv_checksum_dtsi ||
+	    wt_ocv_result != RT942X_WRITE_OCV_PASS) {
+		dev_info(chip->dev, "OCV checksum are the same.\n");
+	} else {
+		dev_info(chip->dev, "OCV checksum are different.\n");
+		rt942x_init_soc(chip);
+	}
+
+	/* clear RI, set 0 to RI bits */
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+	regval = (regval & ~RT942X_RI_MASK);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_FLAG3, regval);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+	if (((regval & RT942X_RI_MASK) >> 8) == 0)
+		dev_info(chip->dev, "RI=0\n");
+	else
+		dev_info(chip->dev, "RI=1\n");
+
+SET_SEAL_CMD:
+	if (rt942x_unseal_wi_retry(chip, false) == RT942X_UNSEAL_FAIL)
+		ret = RT942X_INIT_SEAL_ERR;
+	else if (ret != RT942X_INIT_CKSUM_ERR)
+		ret = RT942X_INIT_PASS;
+
+	if (ret == RT942X_INIT_PASS) {
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_RSVD, chip->pdata->para_version);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(1);
+		dev_info(chip->dev, "Initial Successful\n");
+		chip->online = 1;
+	} else
+		dev_info(chip->dev, "Initial Fail\n");
+
+	return ret;
+}
+
+static int rt_parse_dt(struct device *dev, struct rt942x_platform_data *pdata)
+{
+#ifdef CONFIG_OF
+	struct device_node *np = dev->of_node;
+	int ret, i;
+	char prop_name[64] = {0};
+
+	dev_info(dev, "%s\n", __func__);
+
+	ret = of_property_read_u16(np, "rt,para_version", &pdata->para_version);
+	if (ret < 0)
+		pdata->para_version = 0;
+
+	ret = of_property_read_string(np, "rt,bat_name",
+				      (const char **)&pdata->bat_name);
+	if (ret < 0)
+		pdata->bat_name = NULL;
+
+	ret = of_property_read_u32(np, "rt,battery_type", &pdata->battery_type);
+	if (ret < 0) {
+		dev_info(dev, "uset default battery_type 4350mV, EDV=3200mV\n");
+		pdata->battery_type = 4352;
+	}
+
+	ret = of_property_read_u32(np, "rt,volt_source", &pdata->volt_source);
+	if (ret < 0)
+		pdata->volt_source = RT942X_REG_AV;
+
+	if (pdata->volt_source == 0)
+		pdata->volt_source = 0;
+	else if (pdata->volt_source == 1)
+		pdata->volt_source = RT942X_REG_VBAT;
+	else if (pdata->volt_source == 2)
+		pdata->volt_source = RT942X_REG_OCV;
+	else if (pdata->volt_source == 3)
+		pdata->volt_source = RT942X_REG_AV;
+	else {
+		dev_notice(dev, "pdata->volt_source is out of range, use 3\n");
+		pdata->volt_source = RT942X_REG_AV;
+	}
+
+	ret = of_property_read_u32(np, "rt,temp_source", &pdata->temp_source);
+	if (ret < 0)
+		pdata->temp_source = 0;
+
+	if (pdata->temp_source == 0)
+		pdata->temp_source = 0;
+	else if (pdata->temp_source == 1)
+		pdata->temp_source = RT942X_REG_TEMP;
+	else if (pdata->temp_source == 2)
+		pdata->temp_source = RT942X_REG_INTT;
+	else if (pdata->temp_source == 3)
+		pdata->temp_source = RT942X_REG_AT;
+	else {
+		dev_notice(dev, "pdata->temp_source is out of range, use 0\n");
+		pdata->temp_source = 0;
+	}
+	ret = of_property_read_u32(np, "rt,curr_source", &pdata->curr_source);
+	if (ret < 0)
+		pdata->curr_source = 0;
+	if (pdata->curr_source == 0)
+		pdata->curr_source = 0;
+	else if (pdata->curr_source == 1)
+		pdata->curr_source = RT942X_REG_CURR;
+	else if (pdata->curr_source == 2)
+		pdata->curr_source = RT942X_REG_AI;
+	else {
+		dev_notice(dev, "pdata->curr_source is out of range, use 2\n");
+		pdata->curr_source = RT942X_REG_AI;
+	}
+
+	ret = of_property_read_u8_array(np, "rt,fg_extreg_table",
+					(u8 *)pdata->extreg_table, sizeof(pdata->extreg_table));
+	if (ret < 0)
+		dev_notice(dev, "read fg_extreg_table fail(%d)\n", ret);
+
+	of_property_read_s32(np, "rt,rs_ic_setting", &pdata->rs_ic_setting);
+	of_property_read_s32(np, "rt,rs_schematic", &pdata->rs_schematic);
+
+	dev_info(dev, "rs_ic_setting = %d\n", pdata->rs_ic_setting);
+	dev_info(dev, "rs_schematic = %d\n", pdata->rs_schematic);
+
+	/* add for aging cv */
+	/* parse fcc array element num as maximum ; 2021-12-15 */
+	pdata->ocv_index_array_num = of_property_count_u32_elems(np, "rt,fcc");
+	pdata->ocv_index_array_num = clamp_val(pdata->ocv_index_array_num,
+					       1, OCV_INDEX_ARRAY_NUM_MAX);
+
+	pdata->fcc = devm_kzalloc(dev, pdata->ocv_index_array_num *
+				  sizeof(*pdata->fcc), GFP_KERNEL);
+	if (!pdata->fcc)
+		dev_notice(dev, "fcc alloc fail\n");
+	pdata->fc_vth = devm_kzalloc(dev, pdata->ocv_index_array_num *
+				     sizeof(*pdata->fc_vth), GFP_KERNEL);
+	if (!pdata->fc_vth)
+		dev_notice(dev, "fc_vth alloc fail\n");
+	pdata->ocv_table = devm_kzalloc(dev, pdata->ocv_index_array_num *
+					sizeof(*pdata->ocv_table), GFP_KERNEL);
+	if (!pdata->ocv_table)
+		dev_notice(dev, "ocv_table alloc fail\n");
+
+	/* parse fc_vth array by ocv_index_array_num element */
+	ret = of_property_read_u32_array(np, "rt,fcc", pdata->fcc, pdata->ocv_index_array_num);
+	if (ret < 0) {
+		dev_notice(dev, "no FCC property, use default 2000\n");
+		for (i = 0; i < pdata->ocv_index_array_num; i++)
+			pdata->fcc[i] = 2000;
+	}
+	/* parse fc_vth array by ocv_index_array_num element */
+	ret = of_property_read_u32_array(np, "rt,fg_fc_vth", pdata->fc_vth,
+									pdata->ocv_index_array_num);
+	if (ret < 0) {
+		dev_notice(dev, "no fc_vth property, use default 4200mV\n");
+		for (i = 0; i < pdata->ocv_index_array_num; i++)
+			pdata->fc_vth[i] = 0x0078;
+	}
+	/* parse ocv_table array by ocv_index_array_num * ARRAY_SIZE(*pdata->ocv_table) element */
+	for (i = 0; i < pdata->ocv_index_array_num; i++) {
+		snprintf(prop_name, sizeof(prop_name), "rt,fg_ocv_table%d", i);
+		of_property_read_u32_array(np, prop_name,
+					   pdata->ocv_table[i], ARRAY_SIZE(pdata->ocv_table[i]));
+	}
+
+	/* parse qs source for different rt9427 qs method ; 2022-05-14 */
+	ret = of_property_read_u32(np, "rt,qs_source", &pdata->qs_source);
+	if (ret < 0)
+		pdata->qs_source = RT942X_QS_CMD;
+	if (pdata->qs_source == 0)
+		pdata->qs_source = RT942X_QS_CMD;
+	else if (pdata->qs_source == 1)
+		pdata->qs_source = RT942X_AVGQS_CMD;
+	else if (pdata->qs_source == 2)
+		pdata->qs_source = RT9427_V_AVGQS_CMD;
+	else {
+		dev_notice(dev, "pdata->qs_source is out of range, use 0\n");
+		pdata->qs_source = RT942X_QS_CMD;
+	}
+
+	/* parse init_ocv_table array for init soc ; 2022-01-18 */
+	ret = of_property_read_u32_array(np, "rt,init_ocv_table", pdata->init_ocv_table,
+								  ARRAY_SIZE(pdata->init_ocv_table));
+	if (ret < 0)
+		dev_notice(dev, "no init ocv table property, use default\n");
+
+	/* parse ocv19_table array for rt9427 ocv table ; 2022-05-09 */
+	ret = of_property_read_u32_array(np, "rt,fg_ocv19_table", pdata->ocv19_table, ARRAY_SIZE(pdata->ocv19_table));
+	if (ret < 0)
+		dev_notice(dev, "no short ocv table property\n");
+
+	/* add for ir compensation and software lookup table */
+	ret = of_property_read_u32(np, "rt,ir_comp_resistance", &pdata->ir_comp_resistance);
+	if (ret < 0)
+		dev_info(dev, "no ir_comp_resistance property, use default\n");
+	else
+		dev_info(dev, "ir_comp_resistance = %d\n", pdata->ir_comp_resistance);
+
+	ret = of_property_read_u32(np, "rt,ir_comp_threshold", &pdata->ir_comp_threshold);
+	if (ret < 0)
+		dev_info(dev, "no ir_comp_threshold property, use default\n");
+	else
+		dev_info(dev, "ir_comp_threshold = %d\n", pdata->ir_comp_threshold);
+
+	/* parse bapa_index_table array for rt9427 bapa function ; 2022-05-09 */
+	ret = of_property_read_u32_array(np, "rt,fg_bapa_index_table", pdata->bapa_index_table,
+								       ARRAY_SIZE(pdata->bapa_index_table));
+	if (ret < 0)
+		dev_notice(dev, "no bapa_index_table property\n");
+#endif /* CONFIG_OF */
+	return 0;
+}
+
+static int rt942x_i2c_chipid_check(struct rt942x_chip *chip)
+{
+	unsigned int val = 0;
+	int ret;
+
+	ret = regmap_read(chip->regmap, RT942X_REG_DEVICE_ID, &val);
+	if (ret < 0)
+		return ret;
+
+	/* check device ID is equal to RT9426A/RT9427 or not ; 2022-05-08 */
+	if ((val != RT9426A_DEVICE_ID) &&
+		(val != RT9427_DEVICE_ID) &&
+		(val != RT9427R_DEVICE_ID)) {
+		dev_err(chip->dev, "dev_id not match\n");
+		return -ENODEV;
+	}
+	chip->ic_ver = val;
+	dev_notice(chip->dev, "device id = 0x%x\n", chip->ic_ver);
+	return 0;
+}
+
+static bool rt942x_is_accessible_reg(struct device *dev, unsigned int reg)
+{
+	return (reg % 2) ? false : true;
+}
+
+static const struct regmap_config rt942x_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.writeable_reg = rt942x_is_accessible_reg,
+	.readable_reg = rt942x_is_accessible_reg,
+	.max_register = RT942X_REG_TOTAL_CHKSUM,
+	.val_format_endian = REGMAP_ENDIAN_LITTLE,
+};
+
+static void fg_update_work_func(struct work_struct *work)
+{
+	struct rt942x_chip *chip = container_of(work, struct rt942x_chip, update_work.work);
+
+	dev_info(chip->dev, "%s++\n", __func__);
+	rt942x_update_info(chip);
+	queue_delayed_work(system_freezable_wq, &chip->update_work, 20 * HZ);
+	dev_info(chip->dev, "%s--\n", __func__);
+}
+
+static int rt942x_i2c_probe(struct i2c_client *i2c)
+{
+	struct rt942x_platform_data *pdata = i2c->dev.platform_data;
+	struct rt942x_chip *chip;
+	struct power_supply_config psy_config = {};
+	bool use_dt = i2c->dev.of_node;
+	int ret = 0, i = 0;
+
+	/* alloc memory */
+	chip = devm_kzalloc(&i2c->dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+	if (use_dt) {
+		pdata = devm_kzalloc(&i2c->dev, sizeof(*pdata), GFP_KERNEL);
+		if (!pdata)
+			return -ENOMEM;
+		memcpy(pdata, &def_platform_data, sizeof(*pdata));
+		rt_parse_dt(&i2c->dev, pdata);
+		i2c->dev.platform_data = pdata;
+	} else if (!pdata) {
+		dev_notice(&i2c->dev, "no platdata specified\n");
+		return -EINVAL;
+	}
+	chip->pdata = pdata;
+	chip->i2c = i2c;
+	chip->dev = &i2c->dev;
+	chip->alert_irq = -1;
+	chip->btemp = 250;
+	chip->bvolt = 3800;
+	chip->bcurr = 1000;
+	chip->design_capacity = 2000;
+	chip->ocv_checksum_ic = 0;
+	chip->ocv_index = 0;	/* init as 0 */
+
+	mutex_init(&chip->update_lock);
+	INIT_DELAYED_WORK(&chip->update_work, fg_update_work_func);
+#ifdef CONFIG_PM_SLEEP
+	atomic_set(&chip->io_cnt, 0);
+	atomic_set(&chip->is_suspended, 0);
+	init_waitqueue_head(&chip->resume_wait_que);
+#endif /* CONFIG_PM_SLEEP */
+	i2c_set_clientdata(i2c, chip);
+
+	/* rt regmap init */
+	chip->regmap = devm_regmap_init_i2c(i2c, &rt942x_regmap_config);
+	if (IS_ERR(chip->regmap)) {
+		dev_notice(chip->dev, "regmap init fail\n");
+		ret = PTR_ERR(chip->regmap);
+		goto destroy_mutex;
+	}
+
+	/* check chip id first */
+	ret = rt942x_i2c_chipid_check(chip);
+	if (ret < 0) {
+		dev_notice(chip->dev, "chip id check fail\n");
+		goto destroy_mutex;
+	}
+
+	/* load ocv_checksum_dtsi according to IC type ; 2022-05-08 */
+	if (chip->ic_ver == RT9426A_DEVICE_ID)
+		chip->ocv_checksum_dtsi = chip->pdata->ocv_table[chip->ocv_index][RT942X_IDX_OF_OCV_CKSUM];
+	else
+		chip->ocv_checksum_dtsi = chip->pdata->ocv19_table[19];
+
+	/* apply platform data */
+	ret = rt942x_apply_pdata(chip);
+	if (ret < 0) {
+		dev_notice(chip->dev, "apply pdata fail\n");
+		goto destroy_mutex;
+	}
+
+	/* fg psy register */
+	psy_config.of_node = i2c->dev.of_node;
+	psy_config.drv_data = chip;
+	if (pdata->bat_name)
+		fg_psy_desc.name = pdata->bat_name;
+	chip->fg_psy = devm_power_supply_register(chip->dev, &fg_psy_desc, &psy_config);
+	if (IS_ERR(chip->fg_psy)) {
+		dev_notice(chip->dev, "register batt psy fail\n");
+		ret = PTR_ERR(chip->fg_psy);
+		goto destroy_mutex;
+	}
+
+	ret = rt_fg_create_attrs(&chip->fg_psy->dev);
+	if (ret) {
+		dev_notice(chip->dev, "create attrs fail\n");
+		goto destroy_mutex;
+	}
+
+	/* mask irq before irq register */
+	ret = rt942x_irq_enable(chip, false);
+	if (ret < 0) {
+		dev_notice(chip->dev, "irq mask fail\n");
+		goto fail_irq_enable;
+	}
+
+	ret = rt942x_irq_init(chip);
+	if (ret < 0) {
+		dev_notice(chip->dev, "irq init fail\n");
+		goto fail_irq_enable;
+	}
+
+	ret = rt942x_irq_enable(chip, true);
+	if (ret < 0) {
+		dev_notice(chip->dev, "irq unmask fail\n");
+		goto fail_irq_enable;
+	}
+
+	dev_info(chip->dev, "chip ver = 0x%04x\n", chip->ic_ver);
+	queue_delayed_work(system_freezable_wq, &chip->update_work, 5 * HZ);
+
+	return 0;
+
+fail_irq_enable:
+	for (i = 0; i < ARRAY_SIZE(rt_fuelgauge_attrs); i++)
+		device_remove_file(&chip->fg_psy->dev, &rt_fuelgauge_attrs[i]);
+destroy_mutex:
+	mutex_destroy(&chip->update_lock);
+
+	return ret;
+}
+
+static void rt942x_i2c_remove(struct i2c_client *i2c)
+{
+	struct rt942x_chip *chip = i2c_get_clientdata(i2c);
+	int i = 0;
+
+	dev_info(chip->dev, "%s\n", __func__);
+	cancel_delayed_work_sync(&chip->update_work);
+	rt942x_irq_enable(chip, false);
+	disable_irq(chip->alert_irq);
+	for (i = 0; i < ARRAY_SIZE(rt_fuelgauge_attrs); i++)
+		device_remove_file(&chip->fg_psy->dev, &rt_fuelgauge_attrs[i]);
+	mutex_destroy(&chip->update_lock);
+}
+
+#ifdef CONFIG_PM_SLEEP
+static inline void __rt942x_i2c_resume(struct rt942x_chip *chip)
+{
+	atomic_set(&chip->is_suspended, 0);
+	wake_up_all(&chip->resume_wait_que);
+}
+
+static int rt942x_i2c_suspend(struct device *dev)
+{
+	struct rt942x_chip *chip = dev_get_drvdata(dev);
+
+	dev_info(chip->dev, "%s\n", __func__);
+
+	if (atomic_read(&chip->io_cnt))
+		return -EBUSY;
+	atomic_set(&chip->is_suspended, 1);
+	if (atomic_read(&chip->io_cnt)) {
+		__rt942x_i2c_resume(chip);
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+static int rt942x_i2c_resume(struct device *dev)
+{
+	struct rt942x_chip *chip = dev_get_drvdata(dev);
+
+	dev_info(chip->dev, "%s\n", __func__);
+
+	__rt942x_i2c_resume(chip);
+
+	return 0;
+}
+#endif /* CONFIG_PM_SLEEP */
+
+static SIMPLE_DEV_PM_OPS(rt942x_pm_ops, rt942x_i2c_suspend, rt942x_i2c_resume);
+
+static const struct of_device_id rt_match_table[] = {
+	{ .compatible = "richtek,rt9426a", },
+	{ .compatible = "richtek,rt9427", },
+	{ .compatible = "richtek,rt942x", },
+	{},
+};
+MODULE_DEVICE_TABLE(of, rt_match_table);
+
+static struct i2c_driver rt942x_i2c_driver = {
+	.driver = {
+		.name = "rt942x",
+		.of_match_table = of_match_ptr(rt_match_table),
+		.pm = &rt942x_pm_ops,
+	},
+	.probe = rt942x_i2c_probe,
+	.remove = rt942x_i2c_remove,
+};
+module_i2c_driver(rt942x_i2c_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Jeff Chang <jeff_chang@richtek.com>");
+MODULE_DESCRIPTION("RT942X Fuelgauge Driver");
+MODULE_VERSION("1.0.1_G");
