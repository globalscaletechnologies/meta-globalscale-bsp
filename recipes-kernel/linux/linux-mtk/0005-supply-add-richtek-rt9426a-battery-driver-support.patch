+static ssize_t rt_fg_show_attrs(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct rt942x_chip *chip = dev_get_drvdata(dev->parent);
+	const ptrdiff_t offset = attr - rt_fuelgauge_attrs;
+	int ret = 0;
+
+	switch (offset) {
+	case FG_TEMP:
+		ret = scnprintf(buf, PAGE_SIZE, "%d\n", chip->btemp);
+		break;
+	case FG_VOLT:
+		ret = scnprintf(buf, PAGE_SIZE, "%d\n", chip->bvolt);
+		break;
+	case FG_CURR:
+		ret = scnprintf(buf, PAGE_SIZE, "%d\n", chip->bcurr);
+		break;
+	case CALIB_SECURE:
+		ret = scnprintf(buf, PAGE_SIZE,
+				chip->calib_unlock ? "Unlocked\n" : "Locked\n");
+		break;
+	case CALIB_CURRENT:
+		if (!chip->calib_unlock) {
+			ret = -EACCES;
+			break;
+		}
+		rt942x_enter_calibration_mode(chip);
+		ret = scnprintf(buf, PAGE_SIZE, "%d\n",
+				rt942x_get_curr_by_conversion(chip));
+		rt942x_exit_calibration_mode(chip);
+		break;
+	case CALIB_VOLTAGE:
+		if (!chip->calib_unlock) {
+			ret = -EACCES;
+			break;
+		}
+		rt942x_enter_calibration_mode(chip);
+		ret = scnprintf(buf, PAGE_SIZE, "%d\n",
+				rt942x_get_volt_by_conversion(chip));
+		rt942x_exit_calibration_mode(chip);
+		break;
+	case BCCOMP:
+		ret = scnprintf(buf, PAGE_SIZE, "%d\n",
+				rt942x_get_bccomp(chip));
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
+
+static ssize_t rt_fg_store_attrs(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct rt942x_chip *chip = dev_get_drvdata(dev->parent);
+	const ptrdiff_t offset = attr - rt_fuelgauge_attrs;
+	int ret = 0, x = 0, y = 0, val = 0, temp[8];
+	char *org = NULL, *token = NULL, *cur = NULL;
+
+	switch (offset) {
+	case FG_TEMP:
+	case FG_VOLT:
+	case FG_CURR:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		if (offset == FG_TEMP)
+			chip->btemp = val;
+		else if (offset == FG_VOLT)
+			chip->bvolt = val;
+		else if (offset == FG_CURR)
+			chip->bcurr = val;
+		else
+			break;
+		ret = count;
+		break;
+	case FG_UPDATE:
+		rt942x_update_info(chip);
+		ret = count;
+		break;
+	case OCV_TABLE:
+		if (chip->ic_ver != RT9426A_DEVICE_ID) {
+			ret = -EACCES;
+			break;
+		}
+		for (x = 0; x < 10; x++) {
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, 0xCA00 + x);
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, 0xCA00 + x);
+			for (y = 0; y < 8; y++)
+				temp[y] = rt942x_reg_read_word(chip->i2c,
+						RT942X_REG_SWINDOW1 + y * 2);
+
+			dev_info(dev, "fg_ocv_table_%d\n", x);
+			dev_info(dev, "<0x%x 0x%x 0x%x 0x%x>\n",
+				 temp[0], temp[1], temp[2], temp[3]);
+			dev_info(dev, "<0x%x 0x%x 0x%x 0x%x>\n",
+				 temp[4], temp[5], temp[6], temp[7]);
+		}
+		ret = count;
+		break;
+	case ENTER_sleep:
+		rt942x_enter_sleep(chip);
+		dev_info(dev, "FLAG2 = 0x%x\n",
+			 rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2));
+		ret = count;
+		break;
+	case EXIT_sleep:
+		rt942x_exit_sleep(chip);
+		dev_info(dev, "FLAG2 = 0x%x\n",
+			 rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2));
+		ret = count;
+		break;
+	case SET_sleep_DUTY:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		if (val < 0 || val > 15) {
+			dev_notice(dev, "parameters not in range\n");
+			ret = -EINVAL;
+			break;
+		}
+		val = clamp_val(val, 0, 7);
+		rt942x_sleep_duty_set(chip, val);
+		rt942x_sleep_duty_read(chip);
+		ret = count;
+		break;
+	case DBP:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		if (val < 0 || val > 15) {
+			dev_notice(dev, "parameters not in range\n");
+			ret = -EINVAL;
+			break;
+		}
+
+		rt942x_read_page_cmd(chip, RT942X_PAGE_0 + val);
+		dev_info(dev, "fg_data_block_page%d\n", val);
+		for (x = 0; x < 8; x++) {
+			temp[x] = rt942x_reg_read_word(chip->i2c,
+					   RT942X_REG_SWINDOW1 + x * 2);
+			dev_info(dev, "0x%X:<0x%x>\n",
+				      RT942X_REG_SWINDOW1 + x * 2 + 1,
+				      temp[x]);
+		}
+		ret = count;
+		break;
+	case WCNTL:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, val);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		ret = count;
+		break;
+	case WEXTCNTL:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, val);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, val);
+		ret = count;
+		break;
+	case WSW:
+		org = kstrdup(buf, GFP_KERNEL);
+		if (!org) {
+			ret = -ENOMEM;
+			break;
+		}
+		cur = org;
+		x = 0;
+		while ((token = strsep(&cur, " "))) {
+			if (kstrtoint(token, 0, &temp[x]))
+				break;
+			if (++x >= 2)
+				break;
+		}
+		kfree(org);
+		if (x != 2) {
+			dev_notice(dev, "get parameters fail\n");
+			ret = -EINVAL;
+			break;
+		}
+		if (temp[0] < 1 || temp[0] > 8) {
+			dev_notice(dev, "parameters not in range\n");
+			ret = -EINVAL;
+			break;
+		}
+
+		rt942x_reg_write_word(chip->i2c,
+				      RT942X_REG_SWINDOW1 + (temp[0] - 1) * 2,
+				      temp[1]);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		ret = count;
+		break;
+	case WTEMP:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		rt942x_reg_write_word(chip->i2c,
+				      RT942X_REG_TEMP, ((val * 10) + 2732));
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		ret = count;
+		break;
+	case UNSEAL:
+		if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_FAIL)
+			ret = -EINVAL;
+		else
+			ret = count;
+		break;
+	case SEAL:
+		if (rt942x_unseal_wi_retry(chip, false) == RT942X_UNSEAL_FAIL)
+			ret = -EINVAL;
+		else
+			ret = count;
+		ret = count;
+		break;
+	case FG_SET_TEMP:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		rt942x_temperature_set(chip, val);
+		ret = count;
+		break;
+	case FG_RESET:
+		rt942x_reset(chip);
+		ret = count;
+		break;
+	case CALIB_SECURE:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		chip->calib_unlock = (val == 5526789);
+		ret = count;
+		break;
+	case CALIB_RSENSE:
+		if (!chip->calib_unlock) {
+			ret = -EACCES;
+			break;
+		}
+		/* set p1_w1_setting according to dtsi */
+		rt942x_apply_sense_resistor(chip);
+		if (chip->ic_ver == RT9426A_DEVICE_ID)
+			rt942x_apply_calibration_para(chip, 0x80, 0x80, 0x80);
+		else
+			rt942x_apply_calibration_para(chip, 0x80, 0x8000, 0x80);
+		ret = count;
+		break;
+	case CALIB_FACTOR:
+		if (!chip->calib_unlock) {
+			ret = -EACCES;
+			break;
+		}
+		org = kstrdup(buf, GFP_KERNEL);
+		if (!org) {
+			ret = -ENOMEM;
+			break;
+		}
+		cur = org;
+		x = 0;
+		while ((token = strsep(&cur, ","))) {
+			if (kstrtoint(token, 0, &temp[x]))
+				break;
+			if (++x >= 3)
+				break;
+		}
+		kfree(org);
+		if (x != 3) {
+			dev_notice(dev, "get parameters fail\n");
+			ret = -EINVAL;
+			break;
+		}
+		rt942x_apply_calibration_para(chip, temp[0], temp[1], temp[2]);
+		ret = count;
+		break;
+	case FORCE_SHUTDOWN:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+
+		ret = val ? rt942x_enter_hibernate_mode(chip) :
+			    rt942x_exit_hibernate_mode(chip);
+		if (ret)
+			break;
+		ret = count;
+		break;
+	case BCCOMP:
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		if (val < 0xCCD || val > 0x7999) {
+			dev_notice(dev, "parameters not in range\n");
+			ret = -EINVAL;
+			break;
+		}
+
+		ret = rt942x_set_bccomp(chip, val);
+		if (ret)
+			break;
+		ret = count;
+		break;
+	case BAPA_SET:
+		if (chip->ic_ver == RT9426A_DEVICE_ID) {
+			ret = -EACCES;
+			break;
+		}
+		org = kstrdup(buf, GFP_KERNEL);
+		if (!org) {
+			ret = -ENOMEM;
+			break;
+		}
+		cur = org;
+		x = 0;
+		while ((token = strsep(&cur, ","))) {
+			if (kstrtoint(token, 0, &temp[x]))
+				break;
+			if (++x >= 2)
+				break;
+		}
+		kfree(org);
+		if (x != 2) {
+			dev_notice(dev, "get parameters fail\n");
+			ret = -EINVAL;
+			break;
+		}
+		if (temp[0] < 0 || temp[0] > 255 ||
+		    temp[1] < 0 || temp[1] > 255) {
+			dev_notice(dev, "parameters not in range\n");
+			ret = -EINVAL;
+			break;
+		}
+		ret = rt9427_battery_aging_profile_adjust(chip, temp[0], temp[1]);
+		if (ret)
+			break;
+		ret = count;
+		break;
+	case BAPA_FCC_SET:
+		if (chip->ic_ver == RT9426A_DEVICE_ID) {
+			ret = -EACCES;
+			break;
+		}
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		if (val < -50 || val > 50) {
+			dev_notice(dev, "parameters not in range\n");
+			ret = -EINVAL;
+			break;
+		}
+
+		ret = rt9427_bapa_fcc_gain_offset(chip, val);
+		if (ret)
+			break;
+		ret = count;
+		break;
+	case BAPA_IEOC_SET:
+		if (chip->ic_ver == RT9426A_DEVICE_ID) {
+			ret = -EACCES;
+			break;
+		}
+
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		if (val < 0 || val > 255) {
+			dev_notice(dev, "parameters not in range\n");
+			ret = -EINVAL;
+			break;
+		}
+
+		ret = rt9427_ieoc_offset(chip, val);
+		if (ret)
+			break;
+		ret = count;
+		break;
+	case BAPA_DBP:
+		if (chip->ic_ver == RT9426A_DEVICE_ID) {
+			ret = -EACCES;
+			break;
+		}
+
+		ret = kstrtoint(buf, 0, &val);
+		if (ret < 0) {
+			dev_notice(dev, "get parameters fail\n");
+			break;
+		}
+		if (val < 0 || val > 2) {
+			dev_notice(dev, "parameters not in range\n");
+			ret = -EINVAL;
+			break;
+		}
+
+		ret = rt9427_extended_control_access(chip,
+						     RT9427_BAPA_IDX_CMD + val);
+		if (ret < 0)
+			break;
+		dev_info(dev, "bapa_data_block_page%d\n", val);
+		for (x = 0; x < 8; x++) {
+			temp[x] = rt942x_reg_read_word(chip->i2c,
+					   RT942X_REG_SWINDOW1 + x * 2);
+			dev_info(dev, "0x%X:<0x%x>\n",
+				      RT942X_REG_SWINDOW1 + x * 2 + 1,
+				      temp[x]);
+		}
+		ret = count;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
