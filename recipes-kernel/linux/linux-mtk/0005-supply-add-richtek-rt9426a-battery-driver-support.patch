From 035e25e954c0092af2059ab73aba8e302d07ad88 Mon Sep 17 00:00:00 2001
From: Jason Hung <jhung@globalscaletechnologies.com>
Date: Mon, 27 Apr 2026 11:21:23 +0800
Subject: [PATCH] supply: add richtek rt9426a battery driver support

---
 drivers/power/supply/Kconfig          |    7 +
 drivers/power/supply/Makefile         |    1 +
 drivers/power/supply/rt942x_battery.c | 2693 +++++++++++++++++++++++++
 include/linux/power/rt942x_battery.h  |  180 ++
 4 files changed, 2881 insertions(+)
 create mode 100644 drivers/power/supply/rt942x_battery.c
 create mode 100644 include/linux/power/rt942x_battery.h

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index a61bb1283e19..282176346332 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -775,6 +775,13 @@ config CHARGER_RT5033
 	  The device supports pre-charge mode, fast charge mode and
 	  constant voltage mode.
 
+config BATTERY_RT942X
+	tristate "RT942X fuel gauge support"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Say Y to enable support for Richtek RT9426A and RT9427 battery fuel gauge.
+
 config CHARGER_RT9455
 	tristate "Richtek RT9455 battery charger driver"
 	depends on I2C
diff --git a/drivers/power/supply/Makefile b/drivers/power/supply/Makefile
index a8a9fa6de1e9..2aa8469570b8 100644
--- a/drivers/power/supply/Makefile
+++ b/drivers/power/supply/Makefile
@@ -55,6 +55,7 @@ obj-$(CONFIG_BATTERY_MAX17042)	+= max17042_battery.o
 obj-$(CONFIG_BATTERY_MAX1721X)	+= max1721x_battery.o
 obj-$(CONFIG_BATTERY_RT5033)	+= rt5033_battery.o
 obj-$(CONFIG_CHARGER_RT5033)	+= rt5033_charger.o
+obj-$(CONFIG_BATTERY_RT942X)	+= rt942x_battery.o
 obj-$(CONFIG_CHARGER_RT9455)	+= rt9455_charger.o
 obj-$(CONFIG_CHARGER_RT9467)	+= rt9467-charger.o
 obj-$(CONFIG_CHARGER_RT9471)	+= rt9471.o
diff --git a/drivers/power/supply/rt942x_battery.c b/drivers/power/supply/rt942x_battery.c
new file mode 100644
index 000000000000..110edd83c5f3
--- /dev/null
+++ b/drivers/power/supply/rt942x_battery.c
@@ -0,0 +1,2693 @@
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/i2c.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/power_supply.h>
+#include <linux/delay.h>
+#include <linux/of_gpio.h>
+#include <linux/interrupt.h>
+#include <linux/uaccess.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#include <linux/power/rt942x_battery.h>
+
+struct rt942x_chip {
+	struct i2c_client *i2c;
+	struct device *dev;
+	struct rt942x_platform_data *pdata;
+	struct power_supply *fg_psy;
+	struct regmap *regmap;
+	struct mutex update_lock;
+	struct delayed_work update_work;
+	int alert_irq;
+	u8 online:1;
+	u8 present:1;
+	int btemp;
+	int bvolt;
+	int bcurr;
+	u16 ic_ver;
+	int design_capacity;
+	u16 ocv_checksum_ic;
+	u16 ocv_checksum_dtsi;
+	bool calib_unlock;
+	/* for updating aging cv by api */
+	int ocv_index;
+	/* for force temperature set */
+	u32 op_config_1_backup;
+	u16 page_checksum[RT942X_EXT_REG_TABLE_LOOP];
+#ifdef CONFIG_PM_SLEEP
+	atomic_t io_cnt;
+	atomic_t is_suspended;
+	wait_queue_head_t resume_wait_que;
+#endif /* CONFIG_PM_SLEEP */
+};
+
+static const struct rt942x_platform_data def_platform_data = {
+	.para_version = 0,
+	.battery_type = 4352,
+	.temp_source = 0,
+	.volt_source = 0,
+	.curr_source = 0,
+	.qs_source = 0,
+	.rs_ic_setting = 1000,  /* unit:0.01mR ; 1000x0.01 = 10mR(default)*/
+	.rs_schematic = 1000,   /* unit:0.01mR ; 1000x0.01 = 10mR(default)*/
+	.ir_comp_resistance = 0,   /* 0 = disable(default) and update by dtsi */
+	.ir_comp_threshold = 100,   /* 100mA(default) and update by dtsi */
+};
+
+static int rt942x_block_read(struct i2c_client *i2c, u8 reg, int len, void *dst)
+{
+	struct rt942x_chip *chip = i2c_get_clientdata(i2c);
+	int ret;
+
+#ifdef CONFIG_PM_SLEEP
+	atomic_inc(&chip->io_cnt);
+	wait_event(chip->resume_wait_que, !atomic_read(&chip->is_suspended));
+#endif /* CONFIG_PM_SLEEP */
+	ret = regmap_raw_read(chip->regmap, reg, dst, len);
+	if (ret < 0)
+		dev_notice(chip->dev, "RT942x block read 0x%02x fail\n", reg);
+#ifdef CONFIG_PM_SLEEP
+	atomic_dec(&chip->io_cnt);
+#endif /* CONFIG_PM_SLEEP */
+	return ret;
+}
+
+static int rt942x_block_write(struct i2c_client *i2c,
+			      u8 reg, int len, const void *src)
+{
+	struct rt942x_chip *chip = i2c_get_clientdata(i2c);
+	int ret, retried = 0;
+
+#ifdef CONFIG_PM_SLEEP
+	atomic_inc(&chip->io_cnt);
+	wait_event(chip->resume_wait_que, !atomic_read(&chip->is_suspended));
+#endif /* CONFIG_PM_SLEEP */
+retry:
+	ret = regmap_raw_write(chip->regmap, reg, src, len);
+	if (ret < 0) {
+		dev_notice(chip->dev, "RT942x block write 0x%02x fail\n", reg);
+		if (retried++ < 2)
+			goto retry;
+	}
+#ifdef CONFIG_PM_SLEEP
+	atomic_dec(&chip->io_cnt);
+#endif /* CONFIG_PM_SLEEP */
+	return ret;
+}
+
+
+static int rt942x_reg_read_word(struct i2c_client *i2c, u8 reg)
+{
+	u16 data = 0;
+	int ret;
+
+	ret = rt942x_block_read(i2c, reg, 2, &data);
+	return (ret < 0) ? ret : (s32)le16_to_cpu(data);
+}
+
+static int rt942x_reg_write_word(struct i2c_client *i2c, u8 reg, u16 data)
+{
+	data = cpu_to_le16(data);
+	return rt942x_block_write(i2c, reg, 2, (u8 *)&data);
+}
+
+/* caculates page checksum & total checksum */
+static int rt942x_calculate_checksum_crc_from_dtsi(struct rt942x_chip *chip)
+{
+	u8 array_idx, i, j;
+	u16 page_sum, crc_result;
+
+	/* Calculate Page Checksum & Save to Global Array */
+	for (array_idx = 0; array_idx < RT942X_EXT_REG_TABLE_LOOP; array_idx++) {
+		if (chip->ic_ver == RT9426A_DEVICE_ID &&
+		    (array_idx == 4 || array_idx == 9))
+			continue;
+		page_sum = 0;
+		for (i = 0; i < 8; i++) {
+			page_sum += chip->pdata->extreg_table[array_idx][2*i] |
+				    chip->pdata->extreg_table[array_idx][2*i+1] << 8;
+		}
+		chip->page_checksum[array_idx] = 0xFFFF - page_sum;
+		dev_dbg(chip->dev, "RT942x Page Checksum: Page=%d, Ckecksum=0x%x\n", array_idx,
+			chip->page_checksum[array_idx]);
+	}
+
+	/* Calculate Extend Register CRC16 & return */
+	crc_result = 0xFFFF;
+	for (array_idx = 0; array_idx < RT942X_EXT_REG_TABLE_LOOP; array_idx++) {
+		if (chip->ic_ver == RT9426A_DEVICE_ID &&
+		    (array_idx == 4 || array_idx == 9))
+			continue;
+		for (i = 0; i < 16; i++) {
+			crc_result = crc_result ^ chip->pdata->extreg_table[array_idx][i];
+
+			for (j = 0; j < 8; j++) {
+				if (crc_result & 0x01)
+					crc_result = (crc_result >> 1) ^ 0xA001;
+				else
+					crc_result = crc_result >> 1;
+			}
+		}
+	}
+	dev_dbg(chip->dev, "RT942X Ext Reg CRC16=0x%x\n", crc_result);
+
+	return crc_result;
+}
+
+/* get gauge total checksum value */
+static int rt942x_get_checksum_from_ic(struct rt942x_chip *chip)
+{
+	u8 retry_times = 3, i;
+	u16 regval, checksum_result;
+
+	while (retry_times) {
+		/*  Send Command to get Total Checksum */
+		if (rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL,
+					  RT942X_TOTAL_CHKSUM_CMD) >= 0) {
+			rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+			mdelay(5);
+			/* Polling [BUSY] flag */
+			for (i = 0; i < 10; i++) {
+				regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+				if (regval & RT942X_GAUGE_BUSY_MASK)
+					mdelay(1);
+				else
+					break;
+			}
+			/* Get Total Checksum */
+			checksum_result = rt942x_reg_read_word(chip->i2c, RT942X_REG_TOTAL_CHKSUM);
+			if ((regval & RT942X_GAUGE_BUSY_MASK) == 0)
+				break;
+		}
+		retry_times--;
+		if (retry_times == 0) {
+			dev_dbg(chip->dev, "RT942x Sent Total Checksum Command Fail\n");
+			return 0xFFFF;
+		}
+		dev_dbg(chip->dev, "RT942x Sent Total Checksum Command Retry\n");
+	}
+
+	dev_dbg(chip->dev, "Get RT942x Total Checksum = 0x%x\n", checksum_result);
+	return checksum_result;
+}
+
+static void rt942x_read_page_cmd(struct rt942x_chip *chip, u16 page)
+{
+	u16 read_page_cmd = 0x6500;
+	int i, regval, retry_times = 2;
+
+	read_page_cmd += page;
+
+	/* confirm sending read page cmd successfully ; 2021-10-26 */
+	for (i = 0; i < retry_times; i++) {
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, read_page_cmd);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, read_page_cmd);
+		mdelay(5);
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW1);
+		if (regval != 0xFFFF)
+			break;
+	}
+
+}
+
+static int rt942x_write_page_cmd(struct rt942x_chip *chip, u8 page)
+{
+	u16 write_page_cmd = 0x6550;
+	int ret = 0;
+
+	write_page_cmd += page;
+	ret = rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, write_page_cmd);
+	ret |= rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, write_page_cmd);
+	mdelay(5);
+
+	return ret;
+}
+
+static int rt942x_unseal_wi_retry(struct rt942x_chip *chip, bool unseal)
+{
+	int i = 0, regval = 0, ret = RT942X_UNSEAL_FAIL;
+	const int retry_times = 3;
+	const int status = unseal ? RT942X_UNSEAL_STATUS : RT942X_SEAL_STATUS;
+retry:
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+	if ((regval & RT942X_UNSEAL_MASK) == status) {
+		dev_info(chip->dev, "RT942x %s Pass\n",
+				    unseal ? "Unseal" : "Seal");
+		ret = RT942X_UNSEAL_PASS;
+		goto out;
+	} else {
+		if (i > 0)
+			dev_info(chip->dev, "RT942x %s Fail\n",
+					    unseal ? "Unseal" : "Seal");
+		if (i++ >= retry_times)
+			goto out;
+	}
+
+	if (unseal) {
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL,
+				      (RT942X_Unseal_Key & 0xffff));
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL,
+				      (RT942X_Unseal_Key >> 16));
+	} else {
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL,
+				      RT942X_SEAL_CMD);
+	}
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+	mdelay(5);
+	goto retry;
+
+out:
+	return ret;
+}
+
+/* add for RT9427 ; 2022-05-08 */
+static int rt9427_extended_control_access(struct rt942x_chip *chip,
+					  u16 wt_command)
+{
+	u8 retry_cnt = 0, loop = 0;
+	u16 regval = 0;
+
+	for (retry_cnt = 0; retry_cnt < 5; retry_cnt++) {
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, wt_command);
+		for (loop = 0; loop < 40; loop++) {
+			mdelay(1);
+			regval = rt942x_reg_read_word(chip->i2c, RT9427_REG_EXT_CMD);
+			dev_info(chip->dev, "%s, RT9427 write = 0x%04X, get = 0x%04X\n",
+					__func__, wt_command, regval);
+			if (regval == wt_command)
+				return RT9427_PASS;
+		}
+	}
+	return RT9427_FAIL;
+}
+
+static void rt942x_sleep_duty_set(struct rt942x_chip *chip, u16 data)
+{
+	int regval;
+
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_PASS) {
+		rt942x_read_page_cmd(chip, RT942X_PAGE_1);
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW7);
+		regval = ((regval & 0xfff8) | (data & 0x0007));
+		rt942x_write_page_cmd(chip, RT942X_PAGE_1);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW7, regval);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(10);
+	}
+
+	rt942x_unseal_wi_retry(chip, false);
+}
+
+static void rt942x_sleep_duty_read(struct rt942x_chip *chip)
+{
+	int regval;
+
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_PASS) {
+		rt942x_read_page_cmd(chip, RT942X_PAGE_1);
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW7);
+		regval = (regval & 0x0007);
+		dev_info(chip->dev, "Sleep_Dutty = 2^%d sec)\n", regval);
+	}
+
+	rt942x_unseal_wi_retry(chip, false);
+}
+
+static void rt942x_enter_sleep(struct rt942x_chip *chip)
+{
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, 0x74AA);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+}
+
+static void rt942x_exit_sleep(struct rt942x_chip *chip)
+{
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, 0x7400);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+}
+
+/* "data" is input temperature with unit = .1'C */
+static void rt942x_temperature_set(struct rt942x_chip *chip, int data)
+{
+	dev_info(chip->dev, "%s: temp = %d .1'C\n", __func__, data);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_TEMP, data + 2732);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+}
+
+static void rt942x_reset(struct rt942x_chip *chip)
+{
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, 0x0041);
+	mdelay(1000);
+}
+
+static int rt942x_get_volt(struct rt942x_chip *chip)
+{
+	if (chip->pdata->volt_source)
+		chip->bvolt = rt942x_reg_read_word(chip->i2c, chip->pdata->volt_source);
+
+	return chip->bvolt;
+}
+
+static int rt942x_get_temp(struct rt942x_chip *chip)
+{
+	if (chip->pdata->temp_source) {
+		chip->btemp = rt942x_reg_read_word(chip->i2c, chip->pdata->temp_source);
+		chip->btemp -= 2732;
+	}
+
+	return chip->btemp;
+}
+
+static unsigned int rt942x_get_cyccnt(struct rt942x_chip *chip)
+{
+	int ret;
+	unsigned int cyccnt = 0;
+
+	ret = rt942x_reg_read_word(chip->i2c, RT942X_REG_CYC);
+	if (ret < 0)
+		dev_notice(chip->dev, "%s: read cycle count fail\n", __func__);
+	else
+		cyccnt = ret;
+
+	return cyccnt;
+}
+
+static int rt942x_get_current(struct rt942x_chip *chip)
+{
+	int bcurr = chip->bcurr;
+
+	if (chip->pdata->curr_source) {
+		bcurr = rt942x_reg_read_word(chip->i2c, chip->pdata->curr_source);
+		if (bcurr < 0)
+			return bcurr;
+		if (bcurr > 0x7FFF)
+			bcurr = bcurr - 0x10000;
+		/* scaling for RT9426A only */
+		if (chip->ic_ver == RT9426A_DEVICE_ID)
+			bcurr = bcurr * chip->pdata->rs_ic_setting /
+					chip->pdata->rs_schematic;
+	}
+	chip->bcurr = bcurr;
+	return bcurr;
+}
+
+static unsigned int rt942x_get_design_capacity(struct rt942x_chip *chip)
+{
+	chip->design_capacity = rt942x_reg_read_word(chip->i2c, RT942X_REG_DC);
+	if (chip->design_capacity < 0)
+		return -EIO;
+
+	/* scaling for RT9426A only */
+	if (chip->ic_ver == RT9426A_DEVICE_ID)
+		chip->design_capacity = chip->design_capacity *
+					chip->pdata->rs_ic_setting /
+					chip->pdata->rs_schematic;
+
+	return chip->design_capacity;
+}
+
+/* checking cycle_cnt & bccomp */
+static int rt942x_set_cyccnt(struct rt942x_chip *chip, unsigned int cyc_new)
+{
+	int ret;
+	unsigned int cyccnt = 0;
+
+	ret = rt942x_reg_write_word(chip->i2c, RT942X_REG_CNTL, RT942X_SET_CYCCNT_KEY);
+	if (ret < 0)
+		dev_notice(chip->dev, "%s: send keyword to set cycle count fail\n", __func__);
+	else {
+		mdelay(1);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_CYC, cyc_new);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(5);
+		/* read back check */
+		cyccnt = rt942x_reg_read_word(chip->i2c, RT942X_REG_CYC);
+		if (cyccnt == cyc_new) {
+			ret = cyccnt;
+			dev_notice(chip->dev, "%s: set cycle count to %d successfully\n", __func__, cyccnt);
+		} else {
+			ret = -1;
+			dev_notice(chip->dev, "%s: set cycle count failed, target = %d, now = %d\n",
+						__func__, cyc_new, cyccnt);
+		}
+	}
+
+	return ret;
+}
+
+static int rt942x_get_bccomp(struct rt942x_chip *chip)
+{
+	int regval = 0, retry_times = 2;
+
+	while (retry_times-- > 0) {
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_BCCOMP);
+		dev_notice(chip->dev, "%s: BCCOMP now is 0x%04X\n", __func__, regval);
+		if ((regval > 0xCCD) && (regval < 0x7999))
+			return regval;
+	}
+
+	return -EINVAL;
+}
+
+static int rt942x_set_bccomp(struct rt942x_chip *chip, unsigned int bccomp_new)
+{
+	int ret = 0, opcfg4 = 0, opcfg4_new = 0;
+
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_FAIL) {
+		ret = -EINVAL;
+		goto out;
+	}
+	/* Get present OPCFG4 */
+	rt942x_read_page_cmd(chip, RT942X_PAGE_1);
+	opcfg4 = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW4);
+	opcfg4_new = opcfg4 | 0x0040;
+	/* Enable SET_BCOMP by set OPCFG4 */
+	rt942x_write_page_cmd(chip, RT942X_PAGE_1);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW4, opcfg4_new);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+	mdelay(1);
+	/* Set new BCCOMP */
+	rt942x_write_page_cmd(chip, RT942X_PAGE_2);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW5, bccomp_new);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+	mdelay(1);
+	dev_notice(chip->dev, "%s: Set BCCOMP as 0x%04X\n", __func__, bccomp_new);
+	/* Recover OPCFG4 */
+	rt942x_write_page_cmd(chip, RT942X_PAGE_1);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW4, opcfg4);
+	rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+	mdelay(1);
+out:
+	/* Seal after reading */
+	rt942x_unseal_wi_retry(chip, false);
+	return ret;
+}
+
+static unsigned int rt942x_get_ocv_checksum_from_ic(struct rt942x_chip *chip)
+{
+	int i, regval = 0, retry_times = 2;
+
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_FAIL)
+		chip->ocv_checksum_ic = 0xFFFF;
+	else {
+		/* confirm sending read page cmd successfully ; 2021-10-29 */
+		for (i = 0; i < retry_times; i++) {
+			/* get ocv checksum from ic according to ic type ; 2022-05-08 */
+			if (chip->ic_ver == RT9426A_DEVICE_ID) {
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, 0xCA09);
+				rt942x_reg_write_word(chip->i2c, RT942X_REG_BDCNTL, 0xCA09);
+				mdelay(5);
+				regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW4);
+				chip->ocv_checksum_ic = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW5);
+				if ((regval != 0xFFFF) || (chip->ocv_checksum_ic != 0xFFFF))
+					break;
+			} else {
+				rt9427_extended_control_access(chip, RT9427_WTOCV19_CMD + 2);
+				mdelay(5);
+				chip->ocv_checksum_ic = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW4);
+				if (chip->ocv_checksum_ic != 0xFFFF)
+					break;
+			}
+		}
+	}
+	rt942x_unseal_wi_retry(chip, false);
+
+	return chip->ocv_checksum_ic;
+}
+
+static int rt942x_write_ocv_table(struct rt942x_chip *chip)
+{
+	int retry_times = 3, i = 0, j = 0, regval, ret = RT942X_WRITE_OCV_FAIL;
+	const u32 *pval = NULL;
+
+	if (chip->ic_ver == RT9426A_DEVICE_ID) {
+		pval = chip->pdata->ocv_table[chip->ocv_index];
+		if (*pval != 0x13)
+			return ret;
+	} else
+		pval = chip->pdata->ocv19_table;
+
+	dev_info(chip->dev, "Write NEW OCV Table\n");
+
+	if (chip->ic_ver == RT9426A_DEVICE_ID) {
+		while (retry_times) {
+			for (i = 0; i < 10; i++) {
+				rt942x_reg_write_word(chip->i2c,
+						      RT942X_REG_BDCNTL, 0xCB00 + i);
+				rt942x_reg_write_word(chip->i2c,
+						      RT942X_REG_BDCNTL, 0xCB00 + i);
+				for (j = 0; j < 8; j++) {
+					if (i == 9 && j >= 5)
+						break;
+					rt942x_reg_write_word(chip->i2c,
+						 RT942X_REG_SWINDOW1 + j * 2,
+						 *(pval + i * 8 + j));
+					mdelay(1);
+				}
+			}
+			rt942x_reg_write_word(chip->i2c,
+					      RT942X_REG_DUMMY, 0x0000);
+			mdelay(10);
+			regval = rt942x_reg_read_word(chip->i2c,
+						      RT942X_REG_FLAG2);
+			if (regval & RT942X_USR_TBL_USED_MASK) {
+				dev_info(chip->dev, "OCV Table Write Successful\n");
+				ret = RT942X_WRITE_OCV_PASS;
+				break;
+			}
+			retry_times--;
+			if (retry_times == 0)
+				dev_notice(chip->dev, "Set OCV Table fail\n");
+		}
+	} else { /* for RT9427 ; 2022-05-08 */
+		while (retry_times) {
+			/* program ocv data */
+			for (i = 0; i < 3; i++) {
+				rt9427_extended_control_access(chip, RT9427_WTOCV19_CMD + i);
+				for (j = 0; j < 8; j++) {
+					if (i == 2 && j >= 4)
+						break;
+					rt942x_reg_write_word(chip->i2c,
+							RT942X_REG_SWINDOW1 + (j * 2), *(pval+(i*8)+j));
+				}
+				mdelay(1);
+			}
+			/* polling ocv program status */
+			mdelay(10);
+			for (i = 0; i < 50; i++) {
+				regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+				if (!(regval & MASK_REG_FLAG3_TBL_IS_PRM))
+					break;
+				mdelay(1);
+			}
+			/* check ocv program result */
+			regval = rt942x_reg_read_word(chip->i2c,
+						      RT942X_REG_FLAG2);
+			if (regval & RT942X_USR_TBL_USED_MASK) {
+				dev_info(chip->dev, "OCV Table Write Successful\n");
+				ret = RT942X_WRITE_OCV_PASS;
+				break;
+			}
+			retry_times--;
+			if (retry_times == 0)
+				dev_notice(chip->dev, "Set OCV Table fail\n");
+		}
+	}
+
+	return ret;
+}
+
+static int rt942x_apply_pdata(struct rt942x_chip *);
+static void rt942x_update_info(struct rt942x_chip *chip)
+{
+	int regval = 0, flag1 = 0, flag2 = 0, retry_times = 0, i;
+	int regval_1 = 0, regval_2 = 0;
+	static int st_charging = -1;
+
+	dev_dbg(chip->dev, "%s\n", __func__);
+	mutex_lock(&chip->update_lock);
+
+	if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_FAIL)
+		goto end_update_info;
+
+	/* check if re-init is necessary */
+	retry_times = 3;
+	for (i = 0 ; i < retry_times ; i++) {
+		regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+		if ((regval & RT942X_RI_MASK) && (regval != 0xFFFF)) {
+			dev_info(chip->dev, "Init RT942x by [RI]\n");
+			rt942x_apply_pdata(chip);
+			break;
+		} else if (regval != 0xFFFF)
+			break;
+		mdelay(5);
+	}
+
+	/* read OPCFG1~7 to check */
+	rt942x_read_page_cmd(chip, RT942X_PAGE_1);
+
+	dev_info(chip->dev, "OPCFG1~5(0x%x 0x%x 0x%x 0x%x 0x%x)\n",
+		 rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW1),
+		 rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW2),
+		 rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW3),
+		 rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW4),
+		 rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW5));
+
+	rt942x_read_page_cmd(chip, RT942X_PAGE_10);
+
+	dev_info(chip->dev, "OPCFG6~7(0x%x 0x%x)\n",
+		 rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW1),
+		 rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW2));
+
+	flag2 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2);
+
+	rt942x_read_page_cmd(chip, RT942X_PAGE_2);
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW1);
+	regval = (regval & 0x0300) >> 8;
+	if (flag2 & RT942X_USR_TBL_USED_MASK) {
+		dev_info(chip->dev, "OCV table define by User\n");
+	} else {
+		if (regval == 0)
+			dev_info(chip->dev, "OCV(4200) EDV(3200)\n");
+		else if (regval == 1)
+			dev_info(chip->dev, "OCV(4350) EDV(3200)\n");
+		else if (regval == 2)
+			dev_info(chip->dev, "OCV(4400) EDV(3200)\n");
+		else
+			dev_info(chip->dev, "OCV(4350) EDV(3400)\n");
+	}
+
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW5);
+	dev_info(chip->dev, "CSCOMP4(%d)\n", regval);
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW4);
+	dev_info(chip->dev, "CSCOMP5(%d)\n", regval);
+
+	regval_1 = rt942x_reg_read_word(chip->i2c, RT942X_REG_DC);
+	regval_2 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FCC);
+	/* scaling for RT9426A only */
+	if (chip->ic_ver == RT9426A_DEVICE_ID) {
+		regval_1 = regval_1 * chip->pdata->rs_ic_setting /
+				      chip->pdata->rs_schematic;
+		regval_2 = regval_2 * chip->pdata->rs_ic_setting /
+				      chip->pdata->rs_schematic;
+	}
+	dev_info(chip->dev, "DSNCAP(%d) FCC(%d)\n", regval_1, regval_2);
+
+	dev_info(chip->dev, "VOLT_SOURCE(0x%x) INPUT_VOLT(%d) FG_VBAT(%d) FG_OCV(%d) FG_AV(%d)\n",
+		chip->pdata->volt_source, rt942x_get_volt(chip),
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_VBAT),
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_OCV),
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_AV));
+
+	regval_1 = rt942x_reg_read_word(chip->i2c, RT942X_REG_CURR);
+	regval_2 = rt942x_reg_read_word(chip->i2c, RT942X_REG_AI);
+	/* scaling for RT9426A only */
+	if (chip->ic_ver == RT9426A_DEVICE_ID) {
+		regval_1 = regval_1 * chip->pdata->rs_ic_setting /
+				      chip->pdata->rs_schematic;
+		regval_2 = regval_2 * chip->pdata->rs_ic_setting /
+				      chip->pdata->rs_schematic;
+	}
+	dev_info(chip->dev, "CURR_SOURCE(0x%x) INPUT_CURR(%d) FG_CURR(%d) FG_AI(%d)\n",
+		chip->pdata->curr_source, rt942x_get_current(chip), regval_1, regval_2);
+
+	dev_info(chip->dev, "TEMP_SOURCE(0x%x) INPUT_TEMP(%d) FG_TEMP(%d)\n",
+			chip->pdata->temp_source, rt942x_get_temp(chip),
+			rt942x_reg_read_word(chip->i2c, RT942X_REG_TEMP));
+	dev_info(chip->dev, "FG_FG_INTT(%d) FG_AT(%d)\n",
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_INTT),
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_AT));
+
+	flag1 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG1);
+	dev_info(chip->dev, "FLAG1(0x%x)\n", flag1);
+	if (((flag1 & 0x0200) >> 9) == 1)
+		dev_info(chip->dev, "FC = 1\n");
+	else
+		dev_info(chip->dev, "FC = 0\n");
+
+	if (((flag1 & 0x0004) >> 2) == 1)
+		dev_info(chip->dev, "FD = 1\n");
+	else
+		dev_info(chip->dev, "FD = 0\n");
+
+	dev_info(chip->dev, "FLAG2(0x%x)\n", flag2);
+
+	if (((flag2 & 0xE000) >> 13) == 0)
+		dev_info(chip->dev, "Power_Mode (Active)\n");
+	else if (((flag2 & 0xE000) >> 13) == 1)
+		dev_info(chip->dev, "Power_Mode (FST_RSP_ACT)\n");
+	else if (((flag2 & 0xE000) >> 13) == 2) {
+		if (chip->ic_ver == RT9426A_DEVICE_ID)
+			dev_info(chip->dev, "Power_Mode (Shutdown)\n");
+		else
+			dev_info(chip->dev, "Power_Mode (Hibernate)\n");
+	} else
+		dev_info(chip->dev, "Power_Mode (Sleep)\n");
+
+	if (flag2 & RT942X_USR_TBL_USED_MASK)
+		dev_info(chip->dev, "User_Define_Table (IN USE)\n");
+	else
+		dev_info(chip->dev, "User_Define_Table (NOT IN USE)\n");
+	if (flag2 >= 0 && flag2 & RT942X_BATPRES_MASK) {
+		dev_info(chip->dev, "Battery_Status (Inserted)\n");
+		chip->present = 1;
+	} else {
+		dev_info(chip->dev, "Battery_Status (Removed)\n");
+		chip->present = 0;
+	}
+
+	if (((flag2 & 0x0001)) == 1)
+		dev_info(chip->dev, "RLX = 1\n");
+	else
+		dev_info(chip->dev, "RLX = 0\n");
+
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3);
+	dev_info(chip->dev, "FLAG3(0x%x)\n", regval);
+	if (((regval & 0x0100) >> 8) == 1)
+		dev_info(chip->dev, "RI = 1\n");
+	else
+		dev_info(chip->dev, "RI = 0\n");
+
+	if (((regval & RT942X_UNSEAL_MASK)) == RT942X_UNSEAL_STATUS)
+		dev_info(chip->dev, "Unseal\n");
+	else
+		dev_info(chip->dev, "Seal\n");
+
+	dev_info(chip->dev, "CYCCNT(%d)\n", rt942x_get_cyccnt(chip));
+
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SOC);
+	dev_info(chip->dev, "SOC(%d)\n", regval);
+
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_RM);
+	/* scaling for RT9426A only */
+	if (chip->ic_ver == RT9426A_DEVICE_ID)
+		regval = regval * chip->pdata->rs_ic_setting /
+				  chip->pdata->rs_schematic;
+	dev_info(chip->dev, "RM(%d)\n", regval);
+
+	regval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SOH);
+	dev_info(chip->dev, "SOH(%d)\n", regval);
+// for test
+	if (st_charging == -1) {
+		power_supply_changed(chip->fg_psy);
+	} else {
+		if (flag1 & 0x1) {
+			// discharging
+			if (st_charging == 1) {
+				power_supply_changed(chip->fg_psy);
+			}
+			st_charging = 0;
+		} else if ((flag1 & 0x0201) == 0) {
+			// charging
+			if (st_charging == 0) {
+				power_supply_changed(chip->fg_psy);
+			}
+			st_charging = 1;
+		}
+	}
+//
+end_update_info:
+	rt942x_unseal_wi_retry(chip, false);
+	mutex_unlock(&chip->update_lock);
+}
+
+static irqreturn_t rt942x_irq_handler(int irqno, void *param)
+{
+	struct rt942x_chip *chip = param;
+
+	dev_info(chip->dev, "%s\n", __func__);
+	dev_info(chip->dev, "FG_IRQ(0x%x) FG_FLAG1(0x%x) FG_FLAG2(0x%x) FG_FLAG3(0x%x)\n",
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_IRQ),
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG1),
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG2),
+		rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG3));
+
+	rt942x_update_info(chip);
+	power_supply_changed(chip->fg_psy);
+	return IRQ_HANDLED;
+}
+
+static inline int rt942x_get_status(struct rt942x_chip *chip)
+{
+	int flag1 = 0;
+
+	flag1 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG1);
+	if (flag1 < 0)
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+	if (flag1 & RT942X_FC_MASK)
+		return POWER_SUPPLY_STATUS_FULL;
+	if (flag1 & RT942X_DSG_MASK)
+		return POWER_SUPPLY_STATUS_DISCHARGING;
+	return POWER_SUPPLY_STATUS_CHARGING;
+}
+
+static inline int rt942x_get_health(struct rt942x_chip *chip)
+{
+	int flag1 = 0;
+
+	flag1 = rt942x_reg_read_word(chip->i2c, RT942X_REG_FLAG1);
+	if (flag1 < 0)
+		return POWER_SUPPLY_HEALTH_UNKNOWN;
+	if (flag1 & RT942X_OT_MASK)
+		return POWER_SUPPLY_HEALTH_OVERHEAT;
+	if (flag1 & RT942X_FD_MASK)
+		return POWER_SUPPLY_HEALTH_DEAD;
+	if (flag1 & RT942X_OV_MASK)
+		return POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+	if (flag1 & RT942X_OC_MASK)
+		return POWER_SUPPLY_HEALTH_OVERCURRENT;
+	return POWER_SUPPLY_HEALTH_GOOD;
+}
+
+static int rt_fg_get_property(struct power_supply *psy,
+			      enum power_supply_property psp,
+			      union power_supply_propval *val)
+{
+	struct rt942x_chip *chip = power_supply_get_drvdata(psy);
+	int ret = 0;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = chip->online;
+		dev_info(chip->dev, "psp_online = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = chip->present;
+		dev_info(chip->dev, "psp_present = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = rt942x_get_status(chip);
+		dev_info(chip->dev, "psp_status = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		val->intval = rt942x_get_health(chip);
+		dev_info(chip->dev, "psp_health = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = rt942x_get_volt(chip);
+		dev_info(chip->dev, "psp_volt_now = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = chip->pdata->battery_type;
+		dev_info(chip->dev, "psp_volt_max_design = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = rt942x_reg_read_word(chip->i2c, RT942X_REG_SOC);
+		dev_info(chip->dev, "psp_capacity = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = rt942x_get_design_capacity(chip);
+		/* scaling for RT9426A only */
+		if (chip->ic_ver == RT9426A_DEVICE_ID)
+			val->intval = val->intval * chip->pdata->rs_ic_setting /
+						    chip->pdata->rs_schematic;
+		dev_info(chip->dev, "psp_charge_full_design = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		val->intval = rt942x_get_current(chip);
+		dev_info(chip->dev, "psp_curr_now = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		val->intval = rt942x_get_temp(chip);
+		dev_info(chip->dev, "psp_temp = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CYCLE_COUNT:
+		val->intval = rt942x_get_cyccnt(chip);
+		dev_info(chip->dev, "psp_cyccnt = %d\n", val->intval);
+		break;
+	/* add for aging cv */
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		val->intval = chip->ocv_index;
+		dev_info(chip->dev, "ocv index = %d\n", val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		mutex_lock(&chip->update_lock);
+		if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_FAIL) {
+			ret = -EINVAL;
+			goto out;
+		}
+		rt942x_read_page_cmd(chip, RT942X_PAGE_5);
+		ret = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW3);
+		if (ret < 0)
+			goto out;
+		val->intval = ret;
+out:
+		rt942x_unseal_wi_retry(chip, false);
+		mutex_unlock(&chip->update_lock);
+		break;
+	case POWER_SUPPLY_PROP_ENERGY_NOW:
+		val->intval = rt942x_reg_read_word(chip->i2c, RT942X_REG_FCC);
+		dev_info(chip->dev, "psp_energy_now = %d\n", val->intval);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
+
+static int rt_fg_set_property(struct power_supply *psy,
+			      enum power_supply_property psp,
+			      const union power_supply_propval *val)
+{
+	struct rt942x_chip *chip = power_supply_get_drvdata(psy);
+	int ret = 0;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_TEMP:
+		if (chip->pdata->temp_source)
+			rt942x_temperature_set(chip, val->intval);
+		else
+			chip->btemp = val->intval;
+		break;
+	case POWER_SUPPLY_PROP_CYCLE_COUNT:
+		if (val->intval < 0) {
+			ret = -EINVAL;
+			break;
+		}
+		rt942x_set_cyccnt(chip, val->intval);
+		break;
+		/* add for aging cv */
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		if (val->intval < 0 || val->intval > (chip->pdata->ocv_index_array_num - 1)) {
+			ret = -EINVAL;
+			break;
+		}
+		chip->ocv_index = val->intval;
+		/* save to RSVD2 after ocv_index assigned */
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_RSVD2, chip->ocv_index);
+		mutex_lock(&chip->update_lock);
+		if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_FAIL) {
+			ret = -EIO;
+			goto out;
+		}
+		/* write aging ocv table */
+		rt942x_write_ocv_table(chip);
+		/* write aging fcc */
+		rt942x_write_page_cmd(chip, RT942X_PAGE_2);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW7, chip->pdata->fcc[chip->ocv_index]);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_DUMMY, 0x0000);
+		mdelay(5);
+		/* write aging fc_vth */
+		rt942x_write_page_cmd(chip, RT942X_PAGE_5);
+		rt942x_reg_write_word(chip->i2c, RT942X_REG_SWINDOW3,
+				      chip->pdata->fc_vth[chip->ocv_index] |
+				      chip->pdata->extreg_table[5][5] << 8);
+		/* update ocv checksum */
+		chip->ocv_checksum_dtsi = chip->pdata->ocv_table[chip->ocv_index][RT942X_IDX_OF_OCV_CKSUM];
+out:
+		rt942x_unseal_wi_retry(chip, false);
+		mutex_unlock(&chip->update_lock);
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		mutex_lock(&chip->update_lock);
+		if (rt942x_unseal_wi_retry(chip, true) == RT942X_UNSEAL_FAIL) {
+			ret = -EINVAL;
+			goto ccv_out;
+		}
+		ret = rt942x_write_page_cmd(chip, RT942X_PAGE_5);
+		if (ret < 0)
+			goto ccv_out;
+		ret = rt942x_reg_read_word(chip->i2c, RT942X_REG_SWINDOW3);
+		if (ret < 0)
+			goto ccv_out;
+		if (ret != val->intval)
+			ret = rt942x_reg_write_word(chip->i2c,
+						    RT942X_REG_SWINDOW3,
+						    val->intval);
+ccv_out:
+		rt942x_unseal_wi_retry(chip, false);
+		mutex_unlock(&chip->update_lock);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
