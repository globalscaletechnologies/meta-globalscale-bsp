From bb5f7f0626d776599385f759fdd4e41d7504c8f6 Mon Sep 17 00:00:00 2001
From: Jason Hung <jhung@globalscaletechnologies.com>
Date: Fri, 26 Jun 2026 15:20:25 +0800
Subject: [PATCH 2/2] dts: cortadodeck: add label for GT911 touchscreen node

---
 arch/arm64/boot/dts/mediatek/gti-cortadodeck.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/gti-cortadodeck.dts b/arch/arm64/boot/dts/mediatek/gti-cortadodeck.dts
index e5fee87078a9..5aca655907d8 100644
--- a/arch/arm64/boot/dts/mediatek/gti-cortadodeck.dts
+++ b/arch/arm64/boot/dts/mediatek/gti-cortadodeck.dts
@@ -1561,7 +1561,7 @@ &i2c6{
 	clock-frequency = <400000>;
 
 	/* touch device  */
-	touchscreen@14 {
+	touchcreen: touchscreen@14 {
 		compatible = "goodix,gt911";
 		reg = <0x14>;
 		interrupt-parent = <&pio>;
-- 
