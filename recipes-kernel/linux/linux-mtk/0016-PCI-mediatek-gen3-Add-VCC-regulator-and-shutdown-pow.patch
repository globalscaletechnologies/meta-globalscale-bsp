From 4deac239445f1a5362ea46f462721cf256f1a09b Mon Sep 17 00:00:00 2001
From: Jason Hung <jhung@globalscaletechnologies.com>
Date: Thu, 25 Jun 2026 11:11:03 +0800
Subject: [PATCH] PCI: mediatek-gen3: Add VCC regulator and shutdown power-off
 support

Add optional VCC regulator support for PCIe endpoint power control.
Power off the endpoint and assert reset during system shutdown.
---
 drivers/pci/controller/pcie-mediatek-gen3.c | 45 ++++++++++++++++++++-
 1 file changed, 44 insertions(+), 1 deletion(-)

diff --git a/drivers/pci/controller/pcie-mediatek-gen3.c b/drivers/pci/controller/pcie-mediatek-gen3.c
index 6bb200d9608f..d05c174f7e5f 100644
--- a/drivers/pci/controller/pcie-mediatek-gen3.c
+++ b/drivers/pci/controller/pcie-mediatek-gen3.c
@@ -22,6 +22,7 @@
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
 #include <linux/reset.h>
+#include <linux/regulator/consumer.h>
 
 #include "../pci.h"
 
@@ -133,6 +134,7 @@ struct mtk_msi_set {
  * @reg_base: physical register base
  * @mac_reset: MAC reset control
  * @phy_reset: PHY reset control
+ * @vcc: PCIe endpoint power supply
  * @phy: PHY controller block
  * @clks: PCIe clocks
  * @num_clks: PCIe clocks count for this port
@@ -154,6 +156,7 @@ struct mtk_gen3_pcie {
 	struct reset_control *mac_reset;
 	struct reset_control *phy_reset;
 	struct phy *phy;
+	struct regulator *vcc;
 	struct clk_bulk_data *clks;
 	int num_clks;
 	struct mtk_pcie_data *data;
@@ -840,6 +843,16 @@ static int mtk_pcie_parse_port(struct mtk_gen3_pcie *pcie)
 		return ret;
 	}
 
+	pcie->vcc = devm_regulator_get_optional(dev, "vcc");
+	if (IS_ERR(pcie->vcc)) {
+		ret = PTR_ERR(pcie->vcc);
+		if (ret == -ENODEV) {
+			pcie->vcc = NULL;
+		} else {
+			return dev_err_probe(dev, ret, "failed to get vcc regulator\n");
+		}
+	}
+
 	pcie->num_clks = devm_clk_bulk_get_all(dev, &pcie->clks);
 	if (pcie->num_clks < 0) {
 		dev_err(dev, "failed to get clocks\n");
@@ -854,6 +867,13 @@ static int mtk_pcie_power_up(struct mtk_gen3_pcie *pcie)
 	struct device *dev = pcie->dev;
 	int err;
 
+	if (pcie->vcc) {
+		err = regulator_enable(pcie->vcc);
+		if (err) {
+			dev_err(dev, "failed to enable vcc regulator\n");
+			return err;
+		}
+	}
 	/* PHY power on and enable pipe clock */
 	reset_control_deassert(pcie->phy_reset);
 
@@ -892,7 +912,9 @@ static int mtk_pcie_power_up(struct mtk_gen3_pcie *pcie)
 	phy_exit(pcie->phy);
 err_phy_init:
 	reset_control_assert(pcie->phy_reset);
-
+	if (pcie->vcc) {
+		regulator_disable(pcie->vcc);
+	}
 	return err;
 }
 
@@ -907,6 +929,9 @@ static void mtk_pcie_power_down(struct mtk_gen3_pcie *pcie)
 	phy_power_off(pcie->phy);
 	phy_exit(pcie->phy);
 	reset_control_assert(pcie->phy_reset);
+	if (pcie->vcc) {
+		regulator_disable(pcie->vcc);
+	}
 }
 
 static int mtk_pcie_setup(struct mtk_gen3_pcie *pcie)
@@ -995,6 +1020,23 @@ static void mtk_pcie_remove(struct platform_device *pdev)
 	mtk_pcie_power_down(pcie);
 }
 
+static void mtk_pcie_shutdown(struct platform_device *pdev)
+{
+	struct mtk_gen3_pcie *pcie = platform_get_drvdata(pdev);
+	u32 val;
+
+	if (!pcie) {
+		return;
+	}
+
+	/* Put endpoint into reset before removing its power. */
+	val = readl_relaxed(pcie->base + PCIE_RST_CTRL_REG);
+	val |= PCIE_PE_RSTB;
+	writel_relaxed(val, pcie->base + PCIE_RST_CTRL_REG);
+
+	mtk_pcie_power_down(pcie);
+}
+
 static void mtk_pcie_irq_save(struct mtk_gen3_pcie *pcie)
 {
 	int i;
@@ -1123,6 +1165,7 @@ MODULE_DEVICE_TABLE(of, mtk_pcie_of_match);
 static struct platform_driver mtk_pcie_driver = {
 	.probe = mtk_pcie_probe,
 	.remove_new = mtk_pcie_remove,
+	.shutdown = mtk_pcie_shutdown,
 	.driver = {
 		.name = "mtk-pcie-gen3",
 		.of_match_table = mtk_pcie_of_match,
-- 
2.43.0

