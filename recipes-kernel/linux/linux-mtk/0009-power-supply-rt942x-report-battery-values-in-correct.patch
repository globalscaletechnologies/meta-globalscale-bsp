From 4642e779d8154c748ca8f9eb7c5327178c689b39 Mon Sep 17 00:00:00 2001
From: Jason Hung <jhung@globalscaletechnologies.com>
Date: Thu, 7 May 2026 14:11:51 +0800
Subject: [PATCH 1/3] power: supply: rt942x: report battery values in correct
 units

---
 drivers/power/supply/rt942x_battery.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/power/supply/rt942x_battery.c b/drivers/power/supply/rt942x_battery.c
index 98cc4051c6da..a45c55eeae0b 100644
--- a/drivers/power/supply/rt942x_battery.c
+++ b/drivers/power/supply/rt942x_battery.c
@@ -867,11 +867,11 @@ static int rt_fg_get_property(struct power_supply *psy,
 		dev_dbg(chip->dev, "psp_health = %d\n", val->intval);
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
-		val->intval = rt942x_get_volt(chip);
+		val->intval = rt942x_get_volt(chip) * 1000;
 		dev_dbg(chip->dev, "psp_volt_now = %d\n", val->intval);
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
-		val->intval = chip->pdata->battery_type;
+		val->intval = chip->pdata->battery_type * 1000;
 		dev_dbg(chip->dev, "psp_volt_max_design = %d\n", val->intval);
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY:
@@ -881,13 +881,15 @@ static int rt_fg_get_property(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
 		val->intval = rt942x_get_design_capacity(chip);
 		/* scaling for RT9426A only */
-		if (chip->ic_ver == RT9426A_DEVICE_ID)
+		if (chip->ic_ver == RT9426A_DEVICE_ID) {
 			val->intval = val->intval * chip->pdata->rs_ic_setting /
 						    chip->pdata->rs_schematic;
+			val->intval = val->intval * 1000;
+		}
 		dev_dbg(chip->dev, "psp_charge_full_design = %d\n", val->intval);
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
-		val->intval = rt942x_get_current(chip);
+		val->intval = rt942x_get_current(chip) * 1000;
 		dev_dbg(chip->dev, "psp_curr_now = %d\n", val->intval);
 		break;
 	case POWER_SUPPLY_PROP_TEMP:
-- 
