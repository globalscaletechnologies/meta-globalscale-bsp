From 08b789390b24dace341c1249cbb69c7e0bcb21c6 Mon Sep 17 00:00:00 2001
From: Jason Hung <jhung@globalscaletechnologies.com>
Date: Thu, 7 May 2026 14:09:26 +0800
Subject: [PATCH 2/3] power: supply: rt9467: add charger event handling and DTS
 charging config

---
 drivers/power/supply/rt9467-charger.c | 117 ++++++++++++++++++++++++--
 1 file changed, 109 insertions(+), 8 deletions(-)

diff --git a/drivers/power/supply/rt9467-charger.c b/drivers/power/supply/rt9467-charger.c
index fdfdc83ab045..25be789e4fa6 100644
--- a/drivers/power/supply/rt9467-charger.c
+++ b/drivers/power/supply/rt9467-charger.c
@@ -123,7 +123,7 @@ enum rt9467_fields {
 	/* RT9467_REG_CHG_CTRL9 */
 	F_IEOC,
 	/* RT9467_REG_CHG_CTRL12 */
-	F_WT_FC,
+	F_WT_FC, F_TMR_EN,
 	/* RT9467_REG_CHG_CTRL13 */
 	F_OCP,
 	/* RT9467_REG_CHG_CTRL14 */
@@ -217,6 +217,7 @@ static const struct reg_field rt9467_chg_fields[] = {
 	[F_IPREC]		= REG_FIELD(RT9467_REG_CHG_CTRL8, 0, 3),
 	[F_IEOC]		= REG_FIELD(RT9467_REG_CHG_CTRL9, 4, 7),
 	[F_WT_FC]		= REG_FIELD(RT9467_REG_CHG_CTRL12, 5, 7),
+	[F_TMR_EN]		= REG_FIELD(RT9467_REG_CHG_CTRL12, 1, 1),
 	[F_OCP]			= REG_FIELD(RT9467_REG_CHG_CTRL13, 2, 2),
 	[F_AICL_MEAS]		= REG_FIELD(RT9467_REG_CHG_CTRL14, 7, 7),
 	[F_AICL_VTH]		= REG_FIELD(RT9467_REG_CHG_CTRL14, 0, 2),
@@ -280,6 +281,14 @@ struct rt9467_chg_data {
 	unsigned int vid;
 	int ichg_ua;
 	int ieoc_ua;
+
+	/* Added for DTS custom configurations */
+	u32 init_ichg_ua;
+	u32 init_voreg_uv;
+	u32 init_iaicr_ua;
+	u32 init_mivr_uv;
+	u32 init_wt_fc_idx;
+	struct delayed_work psy_changed_work;
 };
 
 static int rt9467_otg_of_parse_cb(struct device_node *of,
@@ -511,9 +520,18 @@ static int rt9467_get_adc(struct rt9467_chg_data *data,
 
 static int rt9467_psy_get_status(struct rt9467_chg_data *data, int *state)
 {
-	unsigned int status;
+	unsigned int status, online;
 	int ret;
 
+	ret = regmap_field_read(data->rm_field[F_PWR_RDY], &online);
+	if (ret)
+		return ret;
+
+	if (!online) {
+		*state = POWER_SUPPLY_STATUS_DISCHARGING;
+		return 0;
+	}
+
 	ret = regmap_field_read(data->rm_field[F_CHG_STAT], &status);
 	if (ret)
 		return ret;
@@ -657,6 +675,7 @@ static int rt9467_psy_get_property(struct power_supply *psy,
 				   union power_supply_propval *val)
 {
 	struct rt9467_chg_data *data = power_supply_get_drvdata(psy);
+	unsigned int stat_val, online;
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_STATUS:
@@ -665,11 +684,20 @@ static int rt9467_psy_get_property(struct power_supply *psy,
 		return regmap_field_read(data->rm_field[F_PWR_RDY], &val->intval);
 	case POWER_SUPPLY_PROP_CURRENT_MAX:
 		mutex_lock(&data->attach_lock);
+#if 0
 		if (data->psy_usb_type == POWER_SUPPLY_USB_TYPE_UNKNOWN ||
 		    data->psy_usb_type == POWER_SUPPLY_USB_TYPE_SDP)
 			val->intval = 500000;
 		else
 			val->intval = 1500000;
+#else
+		regmap_read(data->regmap, RT9467_REG_CHG_STAT, &stat_val);
+		if (!(stat_val & BIT(5))) { // VBAT_LVL = 0，precharge
+			val->intval = 850000; // report 850mA
+		} else {
+			val->intval = data->init_iaicr_ua ? data->init_iaicr_ua : 3250000;
+		}
+#endif
 		mutex_unlock(&data->attach_lock);
 		return 0;
 	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
@@ -697,7 +725,21 @@ static int rt9467_psy_get_property(struct power_supply *psy,
 						    &val->intval);
 	case POWER_SUPPLY_PROP_USB_TYPE:
 		mutex_lock(&data->attach_lock);
+#if 0
 		val->intval = data->psy_usb_type;
+#else
+		regmap_field_read(data->rm_field[F_PWR_RDY], &online);
+
+		if (online) {
+			/* force DCP mode */
+			val->intval = POWER_SUPPLY_USB_TYPE_DCP;
+		} else {
+			/* To avoid Android from incorrectly identifying it as
+			 * wireless charging, set it to 'unknown type'.
+			 */
+			val->intval = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+		}
+#endif
 		mutex_unlock(&data->attach_lock);
 		return 0;
 	case POWER_SUPPLY_PROP_PRECHARGE_CURRENT:
@@ -898,6 +940,13 @@ static irqreturn_t rt9467_statc_handler(int irq, void *priv)
 			dev_err(data->dev, "Failed to handle mivr stat\n");
 	}
 
+	if (evts & RT9467_MASK_PWR_RDY) {
+		if (!(new_stat & RT9467_MASK_PWR_RDY)) {
+			schedule_delayed_work(&data->psy_changed_work, msecs_to_jiffies(1000));
+		} else {
+			power_supply_changed(data->psy);
+		}
+	}
 	return IRQ_HANDLED;
 }
 
@@ -917,6 +966,15 @@ static irqreturn_t rt9467_wdt_handler(int irq, void *priv)
 	return IRQ_HANDLED;
 }
 
+static irqreturn_t rt9467_term_handler(int irq, void *priv)
+{
+	struct rt9467_chg_data *data = priv;
+
+	power_supply_changed(data->psy);
+
+	return IRQ_HANDLED;
+}
+
 static int rt9467_report_usb_state(struct rt9467_chg_data *data)
 {
 	unsigned int usb_stat, power_ready;
@@ -1000,15 +1058,16 @@ static int rt9467_request_interrupt(struct rt9467_chg_data *data)
 		int hwirq;
 		irq_handler_t handler;
 	} rt9467_exclusive_irqs[] = {
-		RT9467_IRQ_DESC(statc, statc, RT9467_IRQ_TS_STATC),
+		RT9467_IRQ_DESC(statc, statc, RT9467_IRQ_CHG_STATC),
 		RT9467_IRQ_DESC(wdt, wdt, RT9467_IRQ_WDTMR),
 		RT9467_IRQ_DESC(attach, usb_state, RT9467_IRQ_ATTACH),
 		RT9467_IRQ_DESC(detach,	usb_state, RT9467_IRQ_DETACH),
 		RT9467_IRQ_DESC(aiclmeas, aiclmeas, RT9467_IRQ_CHG_AICLM),
 	}, rt9466_exclusive_irqs[] = {
-		RT9467_IRQ_DESC(statc, statc, RT9467_IRQ_TS_STATC),
+		RT9467_IRQ_DESC(statc, statc, RT9467_IRQ_CHG_STATC),
 		RT9467_IRQ_DESC(wdt, wdt, RT9467_IRQ_WDTMR),
 		RT9467_IRQ_DESC(aiclmeas, aiclmeas, RT9467_IRQ_CHG_AICLM),
+		RT9467_IRQ_DESC(term, term, RT9467_IRQ_CHG_TERM),
 	}, *chg_irqs;
 	int num_chg_irqs, i, virq, ret;
 
@@ -1044,6 +1103,18 @@ static int rt9467_do_charger_init(struct rt9467_chg_data *data)
 	ret = regmap_write(data->regmap, RT9467_REG_CHG_ADC, 0);
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to reset ADC\n");
+	/* read IAICR / ICHG / VOREG parameters from dts */
+	if (data->init_iaicr_ua)
+		rt9467_set_value_from_ranges(data, F_IAICR, RT9467_RANGE_IAICR, data->init_iaicr_ua);
+
+	if (data->init_ichg_ua)
+		rt9467_set_value_from_ranges(data, F_ICHG, RT9467_RANGE_ICHG, data->init_ichg_ua);
+
+	if (data->init_voreg_uv)
+		rt9467_set_value_from_ranges(data, F_VOREG, RT9467_RANGE_VOREG, data->init_voreg_uv);
+
+	/* config precharge current to max 850mA for large battery */
+	rt9467_set_value_from_ranges(data, F_IPREC, RT9467_RANGE_IPREC, 850000);
 
 	ret = rt9467_get_value_from_ranges(data, F_ICHG, RT9467_RANGE_ICHG,
 					   &data->ichg_ua);
@@ -1081,17 +1152,26 @@ static int rt9467_do_charger_init(struct rt9467_chg_data *data)
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to set TE=1\n");
 
-	/* Set 12hrs fast charger timer */
-	ret = regmap_field_write(data->rm_field[F_WT_FC], 4);
+	/* Set MIVR */
+	if (data->init_mivr_uv) {
+		rt9467_set_value_from_ranges(data, F_VMIVR, RT9467_RANGE_VMIVR, data->init_mivr_uv);
+	}
+	/* Read and set fast charger timer value from dts */
+	ret = regmap_field_write(data->rm_field[F_WT_FC], data->init_wt_fc_idx);
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to set WT_FC\n");
 
-	/* Toggle BC12 function */
+	/* enable timer */
+	ret = regmap_field_write(data->rm_field[F_TMR_EN], 1);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to enable timer\n");
+	/* disable BC12 */
 	ret = regmap_field_write(data->rm_field[F_USBCHGEN], 0);
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to disable BC12\n");
 
-	return regmap_field_write(data->rm_field[F_USBCHGEN], 1);
+	/* enable charger */
+	return regmap_field_write(data->rm_field[F_CHG_EN], 1);
 }
 
 static bool rt9467_is_accessible_reg(struct device *dev, unsigned int reg)
@@ -1177,6 +1257,14 @@ static void rt9467_chg_complete_aicl_done(void *data)
 	complete(aicl_done);
 }
 
+static void rt9467_psy_changed_work_func(struct work_struct *work)
+{
+	struct rt9467_chg_data *data = container_of(work, struct rt9467_chg_data,
+												psy_changed_work.work);
+
+	power_supply_changed(data->psy);
+}
+
 static int rt9467_charger_probe(struct i2c_client *i2c)
 {
 	struct device *dev = &i2c->dev;
@@ -1191,6 +1279,17 @@ static int rt9467_charger_probe(struct i2c_client *i2c)
 	data->dev = &i2c->dev;
 	i2c_set_clientdata(i2c, data);
 
+	if (device_property_read_u32(dev, "richtek,charge-current-ua", &data->init_ichg_ua))
+		data->init_ichg_ua = 2000000;
+	if (device_property_read_u32(dev, "richtek,charge-voltage-uv", &data->init_voreg_uv))
+		data->init_voreg_uv = 4200000;
+	if (device_property_read_u32(dev, "richtek,input-current-limit-ua", &data->init_iaicr_ua))
+		data->init_iaicr_ua = 3250000;
+	if (device_property_read_u32(dev, "richtek,mivr-voltage-uv", &data->init_mivr_uv))
+		data->init_mivr_uv = 10500000;
+	if (device_property_read_u32(dev, "richtek,fast-charge-timer-index", &data->init_wt_fc_idx))
+		data->init_wt_fc_idx = 7;
+
 	/* Default pull charge enable gpio to make 'CHG_EN' by SW control only */
 	ceb_gpio = devm_gpiod_get_optional(dev, "charge-enable", GPIOD_OUT_HIGH);
 	if (IS_ERR(ceb_gpio))
@@ -1258,6 +1357,8 @@ static int rt9467_charger_probe(struct i2c_client *i2c)
 	if (ret)
 		return ret;
 
+	INIT_DELAYED_WORK(&data->psy_changed_work, rt9467_psy_changed_work_func);
+
 	return rt9467_request_interrupt(data);
 }
 
-- 
2.43.0

