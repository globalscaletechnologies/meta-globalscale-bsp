From 1dd4009175e61869d23fc377d050a41d141ea0be Mon Sep 17 00:00:00 2001
From: Jason Hung <jhung@globalscaletechnologies.com>
Date: Thu, 7 May 2026 09:51:32 +0800
Subject: [PATCH] desktop-shell: add battery icon and monitor battery events

Upstream-Status: Inappropriate [embedded device customization]

---
 clients/desktop-shell.c | 212 +++++++++++++++++++++++++++++++++++++++-
 1 file changed, 208 insertions(+), 4 deletions(-)

diff --git a/clients/desktop-shell.c b/clients/desktop-shell.c
index 1937962..4571d41 100644
--- a/clients/desktop-shell.c
+++ b/clients/desktop-shell.c
@@ -39,7 +39,9 @@
 #include <ctype.h>
 #include <time.h>
 #include <assert.h>
-
+#include <sys/socket.h>
+#include <linux/netlink.h>
+#include <sys/epoll.h>
 #include <wayland-client.h>
 
 #include <libweston/config-parser.h>
@@ -106,6 +108,7 @@ struct panel {
 	struct window *window;
 	struct widget *widget;
 	struct wl_list launcher_list;
+	struct panel_battery *battery;
 	struct panel_clock *clock;
 	int painted;
 	enum weston_desktop_shell_panel_position panel_position;
@@ -159,6 +162,16 @@ struct panel_clock {
 	time_t refresh_timer;
 };
 
+struct panel_battery {
+	struct widget *widget;
+	struct panel *panel;
+	struct task uevent_task;
+	int present;
+	int capacity;
+	char status[32];
+	int uevent_fd;
+};
+
 struct unlock_dialog {
 	struct window *window;
 	struct widget *widget;
@@ -537,6 +550,184 @@ panel_add_clock(struct panel *panel)
 	widget_set_redraw_handler(clock->widget, panel_clock_redraw_handler);
 }
 
+/* Read capacity and status from battery sysfs */
+static void
+panel_battery_read_status(struct panel_battery *battery)
+{
+	FILE *fp;
+
+	battery->present = 0;
+	battery->capacity = 0;
+
+	fp = fopen("/sys/class/power_supply/battery/present", "r");
+	if (fp) {
+		if (fscanf(fp, "%d", &battery->present) != 1) {
+			battery->present = 0;
+		}
+		fclose(fp);
+
+		/* no battery present */
+		if (!battery->present) {
+			battery->capacity = 0;
+			snprintf(battery->status, sizeof(battery->status), "Unknown");
+			return;
+		}
+	}
+
+	fp = fopen("/sys/class/power_supply/battery/capacity", "r");
+	if (fp) {
+		if (fscanf(fp, "%d", &battery->capacity) != 1) {
+			battery->capacity = 0;
+		}
+		fclose(fp);
+	}
+
+	fp = fopen("/sys/class/power_supply/battery/status", "r");
+	if (fp) {
+		if (fgets(battery->status, sizeof(battery->status), fp)) {
+			battery->status[strcspn(battery->status, "\n")] = 0;
+		}
+		fclose(fp);
+	} else {
+		snprintf(battery->status, sizeof(battery->status), "Unknown");
+	}
+}
+
+static int
+uevent_match(char *buf, int len, const char *match)
+{
+	int i = 0;
+
+	while (i < len) {
+		if (strcmp(&buf[i], match) == 0) {
+			return 1;
+		}
+		i += strlen(&buf[i]) + 1;
+	}
+	return 0;
+}
+
+static void
+battery_uevent_handler(struct task *task, uint32_t events)
+{
+	struct panel_battery *battery =
+		container_of(task, struct panel_battery, uevent_task);
+
+	char buf[4096];
+	int len;
+
+	len = recv(battery->uevent_fd, buf, sizeof(buf) - 1, 0);
+	if (len <= 0) {
+		return;
+	}
+	buf[len] = '\0';
+
+	if (!uevent_match(buf, len, "SUBSYSTEM=power_supply")) {
+		return;
+	}
+
+	if (!uevent_match(buf, len, "ACTION=change")) {
+		return;
+	}
+
+	/* read battery info */
+	panel_battery_read_status(battery);
+
+	/* trigger battery icon redraw event */
+	widget_schedule_redraw(battery->widget);
+}
+
+static void
+panel_battery_redraw_handler(struct widget *widget, void *data)
+{
+	struct panel_battery *battery = data;
+	cairo_t *cr;
+	struct rectangle alloc;
+
+	widget_get_allocation(widget, &alloc);
+	cr = widget_cairo_create(battery->panel->widget);
+
+	double w = 24, h = 14;
+	double x = alloc.x + (alloc.width - w) / 2.0;
+	double y = alloc.y + (alloc.height - h) / 2.0;
+
+	/* Draw Outline */
+	cairo_set_line_width(cr, 1.5);
+	cairo_set_source_rgba(cr, 1, 1, 1, 0.8);
+	cairo_rectangle(cr, x, y, w, h);
+	cairo_stroke(cr);
+	cairo_rectangle(cr, x + w, y + h/4, 2, h/2);
+	cairo_fill(cr);
+
+	/* Color logic */
+	if (battery->capacity > 50)      cairo_set_source_rgb(cr, 0.2, 0.8, 0.2);
+	else if (battery->capacity > 20) cairo_set_source_rgb(cr, 0.9, 0.7, 0.1);
+	else                             cairo_set_source_rgb(cr, 0.9, 0.2, 0.2);
+
+	double fill_w = (w - 4) * (battery->capacity / 100.0);
+	if (fill_w < 1) fill_w = 1;
+	cairo_rectangle(cr, x + 2, y + 2, fill_w, h - 4);
+	cairo_fill(cr);
+
+	/* Bold Orange charging bolt */
+	if (strcmp(battery->status, "Charging") == 0) {
+		cairo_set_source_rgb(cr, 1.0, 1.0, 1.0);
+		cairo_set_line_width(cr, 2.0);
+		cairo_move_to(cr, x + w/2 + 2, y + 2);
+		cairo_line_to(cr, x + w/2 - 3, y + h/2 + 1);
+		cairo_line_to(cr, x + w/2 + 1, y + h/2 + 1);
+		cairo_line_to(cr, x + w/2 - 2, y + h - 2);
+		cairo_stroke(cr);
+	} else if (!battery->present || strcmp(battery->status, "Unknown") == 0) {
+		cairo_set_source_rgb(cr, 0.0, 0.0, 0.0);
+		cairo_set_line_width(cr, 1.5);
+		cairo_move_to(cr, x + w/2 - 3, y);
+		cairo_line_to(cr, x + w/2 + 3, y);
+		cairo_move_to(cr, x + w/2 - 3, y + h);
+		cairo_line_to(cr, x + w/2 + 3, y + h);
+		cairo_stroke(cr);
+
+		cairo_set_source_rgb(cr, 1.0, 0.0, 0.0);
+		cairo_set_line_width(cr, 4.0);
+
+		cairo_move_to(cr, x + w/2, y);
+		cairo_line_to(cr, x + w/2, y + (h - 4));
+		cairo_stroke(cr);
+
+		cairo_move_to(cr, x + w/2, y + (h - 4) + 2);
+		cairo_line_to(cr, x + w/2, y + (h - 4) + 4);
+		cairo_stroke(cr);
+	}
+	cairo_destroy(cr);
+}
+
+static void
+panel_add_battery(struct panel *panel)
+{
+	struct panel_battery *battery = xzalloc(sizeof *battery);
+	struct sockaddr_nl sa;
+	battery->panel = panel;
+	panel->battery = battery;
+
+	/* Setup Netlink Socket to monitor uevents */
+	battery->uevent_fd = socket(AF_NETLINK, SOCK_DGRAM, NETLINK_KOBJECT_UEVENT);
+
+	if (battery->uevent_fd >= 0) {
+		memset(&sa, 0, sizeof(sa));
+		sa.nl_family = AF_NETLINK;
+		sa.nl_groups = 1; /* Monitor kernel groups */
+		bind(battery->uevent_fd, (struct sockaddr *)&sa, sizeof(sa));
+
+		/* Add FD to Weston's event loop */
+		battery->uevent_task.run = battery_uevent_handler;
+		display_watch_fd(window_get_display(panel->window),
+				 battery->uevent_fd, EPOLLIN, &battery->uevent_task);
+	}
+
+	battery->widget = widget_add_widget(panel->widget, battery);
+	widget_set_redraw_handler(battery->widget, panel_battery_redraw_handler);
+}
+
 static void
 panel_resize_handler(struct widget *widget,
 		     int32_t width, int32_t height, void *data)
@@ -550,6 +741,8 @@ panel_resize_handler(struct widget *widget,
 	int horizontal = panel->panel_position == WESTON_DESKTOP_SHELL_PANEL_POSITION_TOP || panel->panel_position == WESTON_DESKTOP_SHELL_PANEL_POSITION_BOTTOM;
 	int first_pad_h = horizontal ? 0 : DEFAULT_SPACING / 2;
 	int first_pad_w = horizontal ? DEFAULT_SPACING / 2 : 0;
+	int battery_w = 35;
+	int spacing = 5;
 
 	wl_list_for_each(launcher, &panel->launcher_list, link) {
 		widget_set_allocation(launcher->widget, x, y,
@@ -571,9 +764,13 @@ panel_resize_handler(struct widget *widget,
 	else
 		y = height - (h = DEFAULT_SPACING * 3);
 
-	if (panel->clock)
-		widget_set_allocation(panel->clock->widget,
-				      x, y, w + 1, h + 1);
+	if (panel->clock) {
+		if (panel->battery) {
+			widget_set_allocation(panel->battery->widget,
+					      width - battery_w - spacing, y, battery_w, h + 1);
+		}
+		widget_set_allocation(panel->clock->widget, width - w - battery_w - (spacing * 2), y, w + 1, h + 1);
+	}
 }
 
 static void
@@ -648,6 +845,11 @@ panel_destroy(struct panel *panel)
 	if (panel->clock)
 		panel_destroy_clock(panel->clock);
 
+	if (panel->battery) {
+		if (panel->battery->uevent_fd >= 0) close(panel->battery->uevent_fd);
+		widget_destroy(panel->battery->widget);
+	}
+
 	wl_list_for_each_safe(launcher, tmp, &panel->launcher_list, link)
 		panel_destroy_launcher(launcher);
 
@@ -682,6 +884,8 @@ panel_create(struct desktop *desktop, struct output *output)
 	if (panel->clock_format != CLOCK_FORMAT_NONE)
 		panel_add_clock(panel);
 
+	panel_add_battery(panel);
+
 	s = weston_config_get_section(desktop->config, "shell", NULL, NULL);
 	weston_config_section_get_color(s, "panel-color",
 					&panel->color, 0xaa000000);
