+/* --- Wayland wl_output listeners for dynamic sizing --- */
+static void
+output_handle_geometry(void *data, struct wl_output *wl_output,
+		       int32_t x, int32_t y,
+		       int32_t physical_width, int32_t physical_height,
+		       int32_t subpixel,
+		       const char *make, const char *model,
+		       int32_t transform)
+{
+}
+
+static void
+output_handle_mode(void *data, struct wl_output *wl_output,
+		   uint32_t flags, int32_t width, int32_t height,
+		   int32_t refresh)
+{
+	struct virtual_keyboard *vk = data;
+	if (flags & WL_OUTPUT_MODE_CURRENT) {
+		vk->pending_output_width = width;
+	}
+}
+
+static void
+output_handle_done(void *data, struct wl_output *wl_output)
+{
+	struct virtual_keyboard *vk = data;
+	int scale = vk->output_scale > 0 ? vk->output_scale : 1;
+
+	/* Calculate logical width for Wayland surface */
+	int logical_width = vk->pending_output_width / scale;
+
+	if (logical_width > 0 && vk->current_output_width != logical_width) {
+		vk->current_output_width = logical_width;
+
+		if (vk->keyboard && vk->keyboard->window) {
+			/* Force the Window Height to be FIXED and independent of layout!
+			   We always allocate space for 4 rows. Max height capped to avoid huge UI */
+			double base_kw = (double)logical_width / 12.0;
+			double base_kh = base_kw * 1.0;
+			if (base_kh > 70.0) base_kh = 70.0;
+
+			double fixed_window_height = 4.0 * base_kh;
+
+			window_schedule_resize(vk->keyboard->window,
+					       logical_width,
+					       fixed_window_height);
+			widget_schedule_redraw(vk->keyboard->widget);
+		}
+	}
+}
+
+static void
+output_handle_scale(void *data, struct wl_output *wl_output,
+		    int32_t factor)
+{
+	struct virtual_keyboard *vk = data;
+	vk->output_scale = factor;
+}
+
+static const struct wl_output_listener output_listener = {
+	output_handle_geometry,
+	output_handle_mode,
+	output_handle_done,
+	output_handle_scale
+};
