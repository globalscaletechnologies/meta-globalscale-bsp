-			col * key_width, row * key_height,
-			key->width * key_width, key_height);
-	cairo_set_line_width(cr, 3);
+	cairo_rounded_rectangle(cr, x, y, w, h, radius);
+
+	cairo_pattern_t *pat = cairo_pattern_create_linear(x, y, x, y + h);
+
+	if (keyboard->pressed_key == key) {
+		cairo_pattern_add_color_stop_rgb(pat, 0.0, 0.65, 0.65, 0.65);
+		cairo_pattern_add_color_stop_rgb(pat, 1.0, 0.75, 0.75, 0.75);
+	} else {
+		if (key->key_type == keytype_default || key->key_type == keytype_space) {
+			cairo_pattern_add_color_stop_rgb(pat, 0.0, 0.98, 0.98, 0.98);
+			cairo_pattern_add_color_stop_rgb(pat, 1.0, 0.82, 0.82, 0.82);
+		} else {
+			cairo_pattern_add_color_stop_rgb(pat, 0.0, 0.78, 0.78, 0.78);
+			cairo_pattern_add_color_stop_rgb(pat, 1.0, 0.60, 0.60, 0.60);
