+	double padding_y = 6.0;
+	double radius = 5.0;
+	double key_rect_width = key->width * kw;
+	double key_rect_height = kh;
+
+	double x = col * kw + padding_x;
+	double y = row * kh + padding_y;
+	double w = key_rect_width - padding_x * 2;
+	double h = key_rect_height - padding_y * 2;
 
 	cairo_save(cr);
-	cairo_rectangle(cr,
-			col * key_width, row * key_height,
-			key->width * key_width, key_height);
